<script>
  const elementos = Array.from(document.querySelectorAll('.reveal'));
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!('IntersectionObserver' in window) || movimientoReducido) {
    elementos.forEach((elemento) => elemento.classList.add('is-visible'));
  } else {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          entrada.target.classList.add('is-visible');
          observador.unobserve(entrada.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );

    elementos.forEach((elemento) => observador.observe(elemento));
  }

  const enlacesNav = Array.from(document.querySelectorAll('[data-nav-section]'));
  if (enlacesNav.length > 0) {
    const secciones = enlacesNav
      .map((enlace) => document.getElementById(enlace.dataset.navSection))
      .filter(Boolean);

    let pendiente = false;

    function actualizarNav() {
      pendiente = false;
      const limite = window.scrollY + 150;
      let actual = '';

      for (const seccion of secciones) {
        if (seccion.offsetTop <= limite) actual = seccion.id;
      }

      enlacesNav.forEach((enlace) => {
        const activo = enlace.dataset.navSection === actual;
        enlace.classList.toggle('is-active', activo);
        if (activo) enlace.setAttribute('aria-current', 'location');
        else enlace.removeAttribute('aria-current');
      });
    }

    function alDesplazar() {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(actualizarNav);
    }

    actualizarNav();
    window.addEventListener('scroll', alDesplazar, { passive: true });
    window.addEventListener('resize', alDesplazar, { passive: true });
  }
</script>
