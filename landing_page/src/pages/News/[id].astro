---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { news } from '../../lib/local-data.js';

export function getStaticPaths() {
  return news.map((item) => ({ params: { id: String(item.id) }, props: { item } }));
}

const { item } = Astro.props;
const fecha = new Date(item.publishedAt).toLocaleDateString('es-CO', { dateStyle: 'long', timeZone: 'UTC' });
---

<Layout title={item.title + ' | SUTENS'} description={item.description}>
  <article class="mx-auto max-w-3xl px-6 py-16 text-ink">
    <a class="font-bold text-brand-700 underline" href="/News/">Volver a noticias</a>
    <h1 class="display my-6 text-4xl">{item.title}</h1>
    <time datetime={item.publishedAt}>{fecha}</time>
    <Image src={item.imageUrl} alt="" width={900} class="my-6 w-full rounded-2xl" />
    <p class="text-lg leading-relaxed">{item.description}</p>
  </article>
</Layout>
