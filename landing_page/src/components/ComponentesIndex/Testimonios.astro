---
import Icono from './Icono.astro';
import { testimonios } from '../../data/testimonios.js';

// Solo se renderiza si existen testimonios confirmados y autorizados
const tieneTestimonios = Array.isArray(testimonios) && testimonios.length > 0;
---

{tieneTestimonios && (
  <section id="testimonios" class="bg-white px-4 py-20 sm:px-6 sm:py-24" aria-labelledby="testimonios-titulo">
    <div class="mx-auto max-w-6xl">
      <header class="max-w-3xl mb-12 reveal">
        <p class="eyebrow text-brand-700">Voces de nuestros afiliados</p>
        <h2 id="testimonios-titulo" class="display mt-3 text-3xl text-ink sm:text-4xl lg:text-5xl">
          El valor de la unidad sindical
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
          Docentes y directivos que día a día transforman la educación pública en Norte de Santander con el respaldo de SUTENS.
        </p>
      </header>

      <!-- Grid en escritorio y carrusel con snap horizontal en móviles -->
      <div class="flex gap-6 overflow-x-auto pb-4 pt-2 snap-x snap-mandatory sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:overflow-visible sm:pb-0">
        {testimonios.map((t, index) => (
          <article class="flex w-[85vw] max-w-sm shrink-0 flex-col justify-between rounded-2xl border border-line bg-cream p-6 shadow-sm snap-start sm:w-auto sm:max-w-none">
            <div>
              <div class="flex items-center gap-1 text-amber-500 mb-4" aria-hidden="true">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm italic leading-relaxed text-ink">
                "{t.frase}"
              </p>
            </div>

            <div class="mt-6 flex items-center gap-3.5 border-t border-line/60 pt-4">
              {t.fotoUrl ? (
                <img
                  src={t.fotoUrl}
                  alt={`Fotografía de ${t.nombre}`}
                  class="h-11 w-11 rounded-full object-cover ring-2 ring-brand-700/20"
                  loading="lazy"
                />
              ) : (
                <span class="grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br from-[#1b7a3e] to-[#0f3d24] text-xs font-bold text-white shadow-sm">
                  {t.nombre ? t.nombre.slice(0, 2).toUpperCase() : 'SU'}
                </span>
              )}
              <div class="min-w-0">
                <h3 class="truncate text-sm font-extrabold text-ink">{t.nombre}</h3>
                <p class="truncate text-xs font-semibold text-muted">{t.rol}</p>
                <p class="truncate text-[0.7rem] text-brand-700">{t.municipio}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
