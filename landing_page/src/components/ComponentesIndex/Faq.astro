---
import Icono from './Icono.astro';
import { preguntasFrecuentes } from '../../data/faq.js';

// Filtro estricto: solo preguntas con datos confirmados (no [CONFIRMAR])
const preguntasConfirmadas = preguntasFrecuentes.filter((faq) => faq.confirmada);

// Regla institucional: Si quedan menos de 3 preguntas confirmadas, oculta toda la sección
const mostrarSeccion = preguntasConfirmadas.length >= 3;
---

{mostrarSeccion && (
  <section id="faq" class="bg-white px-4 py-20 sm:px-6 sm:py-24" aria-labelledby="faq-titulo">
    <div class="mx-auto max-w-4xl">
      <header class="text-center mb-12 reveal">
        <p class="eyebrow text-brand-700">Resolución de dudas</p>
        <h2 id="faq-titulo" class="display mt-3 text-3xl text-ink sm:text-4xl lg:text-5xl">
          Preguntas frecuentes
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
          Respuestas claras sobre afiliación, acompañamiento y vida sindical en SUTENS.
        </p>
      </header>

      <div class="divide-y divide-line rounded-2xl border border-line bg-cream/50 shadow-sm reveal" style="--reveal-delay: 80ms">
        {preguntasConfirmadas.map((faq, index) => (
          <details class="group p-5 sm:p-6 [&_summary::-webkit-details-marker]:hidden" id={`faq-${faq.id}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-left font-extrabold text-ink transition hover:text-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-700 focus-visible:ring-offset-2 rounded-lg">
              <span class="text-base sm:text-lg">{faq.pregunta}</span>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white text-brand-700 shadow-sm ring-1 ring-line transition group-open:rotate-180">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-2 text-sm leading-relaxed text-muted sm:text-base border-t border-line/40">
              <p>{faq.respuesta}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="mt-10 rounded-2xl border border-line bg-cream p-5 text-center reveal">
        <p class="text-sm text-muted">
          ¿Tienes una inquietud específica sobre tu vinculación?{' '}
          <a
            href="https://wa.me/573185218787"
            target="_blank"
            rel="noopener noreferrer"
            class="font-extrabold text-brand-700 underline hover:text-brand-900"
          >
            Consulta directamente con nosotros por WhatsApp
          </a>
        </p>
      </div>
    </div>
  </section>
)}
