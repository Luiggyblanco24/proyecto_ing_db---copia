---
import Icono from './Icono.astro';
import { cifrasDinamicasConfig, cifrasEstaticas } from '../../data/cifras.js';

// Filtramos solo cifras estáticas con valor real y confirmadas (no [CONFIRMAR])
const estaticasVisibles = cifrasEstaticas.filter((c) => c.visible && c.valor !== null && c.valor !== undefined);
---

<section class="relative z-10 landing-mint px-4 sm:px-6" aria-label="SUTENS en cifras">
  <div id="cifras-panel" class="mx-auto max-w-6xl pt-8 sm:pt-10" hidden>
    <div class="cifras-dark-strip relative overflow-hidden p-6 shadow-[0_24px_64px_rgba(7,26,14,0.5)] sm:p-8">
      <!-- Barra superior con gradiente -->
      <div class="pointer-events-none absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brand-700 via-emerald-400 to-amber-400" aria-hidden="true"></div>

      <!-- Encabezado strip -->
      <div class="mb-6 text-center">
        <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-white/50">SUTENS en cifras</p>
        <h2 class="mt-1 text-xl font-extrabold text-white sm:text-2xl">Nuestra presencia en Norte de Santander</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div data-metric="subdirectivas" class="reveal stat-card flex items-center gap-4 rounded-2xl bg-white/[0.06] border border-white/[0.10] p-5 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.10] hover:border-white/[0.20]" hidden>
          <span class={`grid h-13 w-13 shrink-0 place-items-center rounded-2xl ${cifrasDinamicasConfig.subdirectivas.colorFondo} ${cifrasDinamicasConfig.subdirectivas.colorIcono}`}>
            <Icono name={cifrasDinamicasConfig.subdirectivas.icono} class="h-6 w-6" />
          </span>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-white/50">{cifrasDinamicasConfig.subdirectivas.etiqueta}</p>
            <p class="text-4xl font-extrabold tracking-tight text-white leading-none mt-1"><span data-count>0</span></p>
            <p class="text-xs font-semibold text-white/40 mt-1">{cifrasDinamicasConfig.subdirectivas.descripcion}</p>
          </div>
        </div>

        <div data-metric="cargos" class="reveal stat-card flex items-center gap-4 rounded-2xl bg-white/[0.06] border border-white/[0.10] p-5 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.10] hover:border-white/[0.20]" hidden>
          <span class={`grid h-13 w-13 shrink-0 place-items-center rounded-2xl ${cifrasDinamicasConfig.cargos.colorFondo} ${cifrasDinamicasConfig.cargos.colorIcono}`}>
            <Icono name={cifrasDinamicasConfig.cargos.icono} class="h-6 w-6" />
          </span>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-white/50">{cifrasDinamicasConfig.cargos.etiqueta}</p>
            <p class="text-4xl font-extrabold tracking-tight text-white leading-none mt-1"><span data-count>0</span></p>
            <p class="text-xs font-semibold text-white/40 mt-1">{cifrasDinamicasConfig.cargos.descripcion}</p>
          </div>
        </div>

        <div data-metric="documentos" class="reveal stat-card flex items-center gap-4 rounded-2xl bg-white/[0.06] border border-white/[0.10] p-5 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.10] hover:border-white/[0.20]" hidden>
          <span class={`grid h-13 w-13 shrink-0 place-items-center rounded-2xl ${cifrasDinamicasConfig.documentos.colorFondo} ${cifrasDinamicasConfig.documentos.colorIcono}`}>
            <Icono name={cifrasDinamicasConfig.documentos.icono} class="h-6 w-6" />
          </span>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-white/50">{cifrasDinamicasConfig.documentos.etiqueta}</p>
            <p class="text-4xl font-extrabold tracking-tight text-white leading-none mt-1"><span data-count>0</span></p>
            <p class="text-xs font-semibold text-white/40 mt-1">{cifrasDinamicasConfig.documentos.descripcion}</p>
          </div>
        </div>

        {estaticasVisibles.map((stat) => (
          <div data-metric={stat.id} class="reveal stat-card flex items-center gap-4 rounded-2xl bg-white/[0.06] border border-white/[0.10] p-5 backdrop-blur-sm transition-all duration-300 hover:bg-white/[0.10] hover:border-white/[0.20]">
            <span class="grid h-13 w-13 shrink-0 place-items-center rounded-2xl bg-white/10 text-white">
              <Icono name={stat.icono} class="h-6 w-6" />
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-white/50">{stat.etiqueta}</p>
              <p class="text-4xl font-extrabold tracking-tight text-white leading-none mt-1"><span data-count data-static-total={stat.valor}>0</span></p>
              <p class="text-xs font-semibold text-white/40 mt-1">{stat.descripcion}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import {
    getDirectivaDepartamental,
    getDirectivasSubdirectivas,
    getTotalSubdirectivas,
    getDocumentosPublicos,
  } from '../../lib/public-api.js';

  const panel = document.getElementById('cifras-panel');

  function animarNumero(elemento, total) {
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const formato = new Intl.NumberFormat('es-CO');
    if (reducido) {
      elemento.textContent = formato.format(total);
      return;
    }

    const inicio = performance.now();
    const duracion = 1200;

    function paso(ahora) {
      const avance = Math.min(1, (ahora - inicio) / duracion);
      const suavizado = 1 - Math.pow(1 - avance, 3);
      elemento.textContent = formato.format(Math.round(total * suavizado));
      if (avance < 1) requestAnimationFrame(paso);
    }

    requestAnimationFrame(paso);
  }

  let animado = false;
  function iniciarAnimaciones(items) {
    if (animado) return;
    animado = true;
    for (const { numero, total } of items) {
      animarNumero(numero, total);
    }
  }

  function observarEntrada(items) {
    if (!panel) return;
    if (!('IntersectionObserver' in window)) {
      iniciarAnimaciones(items);
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          iniciarAnimaciones(items);
          observer.disconnect();
          break;
        }
      }
    }, { threshold: 0.15 });

    observer.observe(panel);
  }

  async function cargarCifras() {
    if (!panel) return;

    const [subdirectivas, departamental, documentos, totalSubdirectivas] = await Promise.allSettled([
      getDirectivasSubdirectivas(),
      getDirectivaDepartamental(),
      getDocumentosPublicos(),
      getTotalSubdirectivas(),
    ]);

    const lista = (resultado) => (resultado.status === 'fulfilled' && Array.isArray(resultado.value) ? resultado.value : []);
    const integrantesSubdirectivas = lista(subdirectivas);
    const integrantesDepartamental = lista(departamental);
    const documentosPublicos = lista(documentos);

    const metricas = {
      subdirectivas: totalSubdirectivas.status === 'fulfilled' ? totalSubdirectivas.value.total : null,
      cargos: integrantesSubdirectivas.length + integrantesDepartamental.length,
      documentos: documentosPublicos.length,
    };

    const disponibles = Object.entries(metricas).filter(([, total]) => Number.isFinite(total) && total > 0);
    if (!disponibles.length) return;

    const items = [];
    for (const [clave, total] of disponibles) {
      const item = panel.querySelector(`[data-metric="${clave}"]`);
      if (!item) continue;
      item.hidden = false;
      const numero = item.querySelector('[data-count]');
      if (numero) items.push({ numero, total });
    }

    // Agregar indicadores estáticos visibles si existen
    const estaticos = panel.querySelectorAll('[data-static-total]');
    estaticos.forEach((el) => {
      const total = Number(el.getAttribute('data-static-total'));
      if (Number.isFinite(total) && total > 0) {
        items.push({ numero: el, total });
      }
    });

    panel.hidden = false;
    observarEntrada(items);
  }

  cargarCifras().catch(() => {
    if (panel) panel.hidden = true;
  });
</script>

<style>
  .h-13 { height: 3.25rem; }
  .w-13 { width: 3.25rem; }
</style>
