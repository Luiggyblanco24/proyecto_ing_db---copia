---
import { Picture } from 'astro:assets';
import heroPhoto from '../../assets/landing/5.jpg';
import detailPhoto from '../../assets/landing/3.jpg';
import placeholderPhoto from '../../assets/landing/2.jpg';
---

<section class="hero relative isolate overflow-hidden bg-gradient-to-b from-[#0b2e19] via-[#14532d] to-[#15803d] text-white min-h-screen flex items-center">

  <!-- Orbes de fondo - Atmósfera premium -->
  <div class="absolute top-[-10%] left-[-10%] w-[50rem] h-[50rem] rounded-full bg-brand-600/15 blur-[120px] opacity-30" aria-hidden="true"></div>
  <div class="absolute bottom-[-10%] right-[-10%] w-[60rem] h-[60rem] rounded-full bg-amber-500/10 blur-[140px] opacity-20" aria-hidden="true"></div>
  <div class="absolute top-[20%] right-[-10%] w-[40rem] h-[40rem] rounded-full bg-emerald-500/8 blur-[100px] opacity-15" aria-hidden="true"></div>

  <div class="hero-pattern absolute inset-0 pointer-events-none bg-gradient-to-br from-brand-900/40 via-brand-700/30 to-brand-900/40" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid min-h-[52rem] max-w-7xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr]">

    <!-- Columna izquierda: Título y CTA -->
    <div class="max-w-3xl flex flex-col justify-center sm:justify-center">
      <p class="eyebrow inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-5 py-2 text-[#fde68a] mb-8 shadow-lg">
        <span class="h-1.5 w-1.5 rounded-full bg-[#fbbf24]" aria-hidden="true"></span>
        Sindicato de trabajadores de la educación · Norte de Santander
      </p>

      <h1 class="display mb-6 text-balance text-[4.5rem] leading-[1.02] lg:text-[6rem] lg:leading-[1] tracking-tighter">
        Defensa de la Educación,
        <span class="relative">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#fbbf24] via-[#f59e0b] to-[#d97706] animate-gradient">Unidad de los Trabajadores</span>
          <span class="absolute inset-0 bg-[#fbbf24]/40 blur-xl rounded-full -z-10 animate-glow" aria-hidden="true"></span>
        </span>
      </h1>

      <p class="mb-10 text-lg leading-relaxed text-white/90 max-w-xl mx-auto sm:max-w-none lg:text-xl">
        Unidos defendemos los derechos laborales, el salario justo y la educación pública de calidad para los docentes de Norte de Santander.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center sm:justify-start">
        <a href="/register.html" class="btn btn-accent px-9 py-5 text-lg font-bold tracking-wide flex items-center gap-3 min-h-[3rem]">
          Afíliate a SUTENS
          <svg class="w-5 h-5 transition-transform hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a href="#quienes-somos" class="btn btn-outline-light px-9 py-5 text-lg font-bold tracking-wide flex items-center gap-3 min-h-[3rem]">
          Conoce la organización
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </a>
      </div>

      <!-- Badges de confianza -->
      <div class="mt-12 flex flex-wrap gap-3 justify-center sm:justify-start animate-slide-in">
        <span class="flex items-center gap-2 px-4 py-2 rounded-full border border-white/20 bg-white/5 backdrop-blur-sm text-sm font-bold text-white/90 shadow-lg">
          <svg class="w-4 h-4 text-[#4ade80]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.048A7.002 7.002 0 003 9c0 5.002 3.72 9.32 8.736 9.829M20 12c0 2.828-1.848 5.24-4.439 6.432a11.95 11.95 0 01-3.083-1.417M20 12c0 2.828-1.848 5.24-4.439 6.432a11.95 11.95 0 01-3.083-1.417"/>
          </svg>
          Más de 8 años transformando la educación
        </span>
        <span class="flex items-center gap-2 px-4 py-2 rounded-full border border-white/20 bg-white/5 backdrop-blur-sm text-sm font-bold text-white/90 shadow-lg">
          <svg class="w-4 h-4 text-[#fbbf24]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          Presencia en todo el departamento
        </span>
      </div>
    </div>

    <!-- Columna derecha: Showcase con carrusel -->
    <div class="relative w-full max-w-[48rem] lg:max-w-[52rem] flex flex-col items-center justify-center">
      <!-- Badges flotantes -->
      <div class="absolute -top-6 -right-6 flex flex-col gap-3 z-20">
        <div class="floating-badge px-4 py-2 rounded-xl border border-white/20 bg-white/10 backdrop-blur-md shadow-xl animate-floating-slow">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#4ade80] animate-pulse"></span>
            <span class="text-sm font-bold text-white">100% Confiable</span>
          </div>
        </div>
        <div class="floating-badge px-4 py-2 rounded-xl border border-white/20 bg-white/10 backdrop-blur-md shadow-xl animate-floating-fast">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#fbbf24] animate-pulse"></span>
            <span class="text-sm font-bold text-white">Resultados Garantizados</span>
          </div>
        </div>
      </div>

      <!-- Carrusel de imágenes dinámico -->
      <div id="hero-carousel" class="relative w-full h-[22rem] lg:h-[28rem] mb-4">
        <!-- Imagen 1 (activa) -->
        <div class="carousel-slide absolute inset-0 opacity-100 scale-100 z-10 transition-all duration-800 ease-in-out" data-index="0" aria-hidden="false">
          <div class="glass-card w-full h-full overflow-hidden rounded-3xl relative">
            <Picture
              src={heroPhoto}
              alt="Actividad sindical de SUTENS en Norte de Santander"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[400, 600, 800, 1024]}
              sizes="(min-width: 1024px) 50vw, 90vw"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              quality={85}
              class="w-full h-full object-cover transition duration-1000 ease-in-out hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b2e19]/80 via-transparent to-transparent" aria-hidden="true"></div>
          </div>
        </div>

        <!-- Imagen 2 -->
        <div class="carousel-slide absolute inset-0 opacity-0 scale-95 z-0 transition-all duration-800 ease-in-out" data-index="1" aria-hidden="true">
          <div class="glass-card w-full h-full overflow-hidden rounded-3xl relative">
            <Picture
              src={placeholderPhoto}
              alt="Actividad sindical de SUTENS en territorio"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 33vw, 90vw"
              loading="lazy"
              decoding="async"
              quality={85}
              class="w-full h-full object-cover transition duration-1000 ease-in-out hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b2e19]/80 via-transparent to-transparent" aria-hidden="true"></div>
          </div>
        </div>

        <!-- Imagen 3 -->
        <div class="carousel-slide absolute inset-0 opacity-0 scale-95 z-0 transition-all duration-800 ease-in-out" data-index="2" aria-hidden="true">
          <div class="glass-card w-full h-full overflow-hidden rounded-3xl relative">
            <Picture
              src={detailPhoto}
              alt="Encuentro de trabajadores de la educación de SUTENS"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[320, 480, 640]}
              sizes="(min-width: 640px) 25vw, 90vw"
              loading="lazy"
              decoding="async"
              quality={80}
              class="w-full h-full object-cover transition duration-1000 ease-in-out hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b2e19]/80 via-transparent to-transparent" aria-hidden="true"></div>
          </div>
        </div>
      </div>

      <!-- Controles del carrusel -->
      <div class="lg:hidden flex items-center justify-center gap-4 mt-6">
        <button
          id="carousel-prev"
          class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
          aria-label="Imagen anterior"
          type="button"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <div class="flex items-center gap-2" role="tablist" aria-label="Indicadores del carrusel">
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors" data-index="0" role="tab" aria-selected="true" aria-label="Ir a imagen 1"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors" data-index="1" role="tab" aria-selected="false" aria-label="Ir a imagen 2"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors" data-index="2" role="tab" aria-selected="false" aria-label="Ir a imagen 3"></button>
        </div>
        <button
          id="carousel-next"
          class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
          aria-label="Imagen siguiente"
          type="button"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Controles del carrusel (desktop) -->
      <div class="hidden lg:flex lg:absolute lg:bottom-0 lg:left-1/2 lg:-translate-x-1/2 lg:z-20 lg:gap-4">
        <button
          id="carousel-prev-desktop"
          class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
          aria-label="Imagen anterior"
          type="button"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <div class="flex items-center gap-2" role="tablist" aria-label="Indicadores del carrusel">
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors" data-index="0" role="tab" aria-selected="true" aria-label="Ir a imagen 1"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors" data-index="1" role="tab" aria-selected="false" aria-label="Ir a imagen 2"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors" data-index="2" role="tab" aria-selected="false" aria-label="Ir a imagen 3"></button>
        </div>
        <button
          id="carousel-next-desktop"
          class="p-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
          aria-label="Imagen siguiente"
          type="button"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="hero-wave absolute bottom-0 left-0 right-0 h-32 overflow-hidden">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" fill="#16a34a">
      <path d="M0 78C210 118 380 122 620 92C860 62 1080 18 1440 44V120H0V78Z" />
    </svg>
  </div>
</section>

<script>
  // Carrusel de imágenes del Hero
  (function () {
    const carousel = document.getElementById('hero-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtns = document.querySelectorAll('#carousel-prev, #carousel-prev-desktop');
    const nextBtns = document.querySelectorAll('#carousel-next, #carousel-next-desktop');

    let currentIndex = 0;
    let intervalId = null;
    const SLIDE_DURATION = 5000;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function showSlide(index) {
      if (index >= slides.length) index = 0;
      if (index < 0) index = slides.length - 1;

      currentIndex = index;

      slides.forEach((slide, i) => {
        const isActive = i === index;
        slide.style.opacity = isActive ? '1' : '0';
        slide.style.transform = isActive ? 'scale(1)' : 'scale(0.95)';
        slide.style.zIndex = isActive ? '10' : '0';
        slide.setAttribute('aria-hidden', !isActive);
      });

      dots.forEach((dot, i) => {
        const isActive = i === index;
        dot.classList.toggle('bg-white', isActive);
        dot.classList.toggle('bg-white/50', !isActive);
        dot.setAttribute('aria-selected', isActive);
      });
    }

    function nextSlide() { showSlide(currentIndex + 1); }
    function prevSlide() { showSlide(currentIndex - 1); }

    function startAutoPlay() {
      if (prefersReducedMotion) return;
      intervalId = setInterval(nextSlide, SLIDE_DURATION);
    }

    function stopAutoPlay() {
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
    }

    function addControlListeners(btn, action) {
      btn.addEventListener('click', () => {
        stopAutoPlay();
        action();
        startAutoPlay();
      });
    }

    prevBtns.forEach(btn => addControlListeners(btn, prevSlide));
    nextBtns.forEach(btn => addControlListeners(btn, nextSlide));

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stopAutoPlay();
        showSlide(i);
        startAutoPlay();
      });
    });

    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);
    carousel.addEventListener('focusin', stopAutoPlay);
    carousel.addEventListener('focusout', startAutoPlay);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoPlay(); else startAutoPlay();
    });

    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { stopAutoPlay(); prevSlide(); startAutoPlay(); }
      else if (e.key === 'ArrowRight') { stopAutoPlay(); nextSlide(); startAutoPlay(); }
    });

    showSlide(0);
    startAutoPlay();

    window.heroCarousel = { next: nextSlide, prev: prevSlide, goTo: showSlide, stop: stopAutoPlay, start: startAutoPlay };
  })();
</script>

<style>
  .hero {
    overflow-x: hidden;
  }

  /* Animaciones de gradiente y glow */
  @keyframes gradient-move {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @keyframes glow {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.2); }
  }

  @keyframes floating-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @keyframes floating-fast {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes slide-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-gradient {
    background-size: 200% auto;
    animation: gradient-move 4s linear infinite;
  }

  .animate-glow {
    animation: glow 3s ease-in-out infinite;
  }

  .animate-floating-slow {
    animation: floating-slow 4s ease-in-out infinite;
  }

  .animate-floating-fast {
    animation: floating-fast 3s ease-in-out infinite;
  }

  .animate-slide-in {
    animation: slide-in 0.8s ease-out forwards;
  }

  /* Shimmer effect en botón CTA */
  .btn-accent {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
  }

  .btn-accent::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: all 0.6s ease;
  }

  .btn-accent:hover::before {
    left: 100%;
  }

  /* Glassmorphism card */
  .glass-card {
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    will-change: opacity, transform, z-index;
  }

  .carousel-slide picture,
  .carousel-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Controles del carrusel */
  #carousel-prev,
  #carousel-next,
  #carousel-prev-desktop,
  #carousel-next-desktop {
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  #carousel-prev:active,
  #carousel-next:active,
  #carousel-prev-desktop:active,
  #carousel-next-desktop:active {
    transform: scale(0.95);
  }

  /* Indicadores del carrusel */
  .carousel-dot {
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .carousel-dot[aria-selected="true"] {
    background-color: #fff !important;
    transform: scale(1.2);
  }

  .carousel-dot:focus-visible {
    outline: 2px solid #fbbf24;
    outline-offset: 2px;
  }

  /* Responsivo */
  @media (max-width: 1023px) {
    #hero-carousel {
      height: 20rem;
    }
  }

  @media (max-width: 767px) {
    .min-h-screen {
      min-height: auto;
    }
    #hero-carousel {
      height: 18rem;
    }
    h1.display {
      font-size: 2.5rem;
    }
  }

  /* Movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .carousel-slide {
      transition: none !important;
    }
    .animate-gradient,
    .animate-glow,
    .animate-floating-slow,
    .animate-floating-fast {
      animation: none !important;
    }
  }
</style>