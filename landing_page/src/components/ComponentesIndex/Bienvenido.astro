---
import { Picture } from 'astro:assets';
import heroPhoto from '../../assets/landing/5.jpg';
import detailPhoto from '../../assets/landing/3.jpg';
import placeholderPhoto from '../../assets/landing/2.jpg';
---

<section class="hero landing-green text-white relative overflow-hidden">
  <!-- Partículas flotantes de fondo -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="particle particle-1 h-32 w-32 bg-white/[0.04] top-[12%] left-[8%]"></div>
    <div class="particle particle-2 h-20 w-20 bg-amber-300/[0.07] top-[30%] left-[18%]"></div>
    <div class="particle particle-3 h-14 w-14 bg-emerald-400/[0.08] top-[60%] left-[5%]"></div>
    <div class="particle particle-4 h-24 w-24 bg-white/[0.03] bottom-[10%] right-[12%]"></div>
    <div class="particle particle-5 h-10 w-10 bg-amber-200/[0.09] top-[20%] right-[25%]"></div>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-8 py-10 sm:gap-10 sm:py-14 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-10 lg:py-20 xl:gap-14">
    <div>
      <p class="eyebrow text-amber-200 hero-animate hero-animate-1">
        <span class="inline-flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-300 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-300"></span>
          </span>
          Sindicato de Trabajadores de la Educación · Norte de Santander
        </span>
      </p>
      <h1 class="hero-title mt-3 font-extrabold hero-animate hero-animate-2">
        <span class="block">Defensa de la Educación,</span>
        <span class="block text-amber-300">Unidad de los Trabajadores</span>
      </h1>

      <p class="mt-4 max-w-lg text-base leading-relaxed text-white/90 sm:mt-5 sm:text-lg hero-animate hero-animate-3">
        Unidos defendemos los derechos laborales, el salario justo y la educación pública de calidad para los docentes de Norte de Santander.
      </p>

      <div class="mt-5 flex flex-col items-start gap-1 min-[480px]:flex-row min-[480px]:flex-wrap min-[480px]:items-center min-[480px]:gap-3 sm:mt-6 hero-animate hero-animate-4">
        <a href="/Afiliate/" class="btn hero-join w-full min-[480px]:w-auto btn-shimmer">
          Afíliate a SUTENS
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#quienes-somos" class="hero-about">
          Conoce la organización
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </a>
      </div>

      <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-white/25 pt-4 sm:mt-7 sm:max-w-md sm:gap-4 hero-animate hero-animate-5">
        <div class="flex flex-col">
          <dt class="text-xs font-semibold text-white/85">Fundados</dt>
          <dd class="order-first text-xl font-extrabold text-white sm:text-2xl">2016</dd>
        </div>
        <div class="flex flex-col border-l border-white/25 pl-2 sm:pl-4">
          <dt class="text-xs font-semibold text-white/85">Subdirectivas</dt>
          <dd class="order-first text-xl font-extrabold text-white sm:text-2xl">4</dd>
        </div>
        <div class="flex flex-col border-l border-white/25 pl-2 sm:pl-4">
          <dt class="text-xs font-semibold text-white/85">Departamento</dt>
          <dd class="order-first text-xl font-extrabold text-white sm:text-2xl">NdeS</dd>
        </div>
      </dl>
    </div>

    <figure id="hero-carousel" class="min-w-0 hero-animate hero-animate-3" style="animation-delay: 180ms">
      <div class="carousel-frame relative isolate overflow-hidden rounded-2xl bg-white/10 ring-1 ring-white/20 sm:rounded-3xl">
        <!-- Imagen 1 -->
        <div class="carousel-slide absolute inset-0 opacity-100 scale-100 z-10 transition-all duration-700 ease-in-out rounded-2xl sm:rounded-3xl overflow-hidden" data-index="0" aria-hidden="false">
          <Picture
            data-imagen-portada="inicio-1"
            src={heroPhoto}
            alt="Actividad sindical de SUTENS en Norte de Santander"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 600, 800, 1024]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            quality={85}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Imagen 2 -->
        <div class="carousel-slide absolute inset-0 opacity-0 scale-95 z-0 transition-all duration-700 ease-in-out rounded-2xl sm:rounded-3xl overflow-hidden" data-index="1" aria-hidden="true">
          <Picture
            data-imagen-portada="inicio-2"
            src={placeholderPhoto}
            alt="Afiliados de SUTENS en Norte de Santander"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 600, 800]}
            sizes="(min-width: 768px) 33vw, 90vw"
            loading="lazy"
            decoding="async"
            quality={85}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Imagen 3 -->
        <div class="carousel-slide absolute inset-0 opacity-0 scale-95 z-0 transition-all duration-700 ease-in-out rounded-2xl sm:rounded-3xl overflow-hidden" data-index="2" aria-hidden="true">
          <Picture
            data-imagen-portada="inicio-3"
            src={detailPhoto}
            alt="Encuentro de trabajadores de la educación de SUTENS"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[320, 480, 640]}
            sizes="(min-width: 640px) 25vw, 90vw"
            loading="lazy"
            decoding="async"
            quality={80}
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <div class="mt-2 flex flex-col items-center gap-1">
        <div class="carousel-controls flex items-center justify-center" role="group" aria-label="Controles del carrusel">
          <button id="carousel-prev" class="carousel-ctrl" aria-label="Imagen anterior" type="button">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="flex items-center" role="group" aria-label="Seleccionar imagen">
            <button class="carousel-dot" type="button" data-index="0" aria-pressed="true" aria-label="Imagen 1"></button>
            <button class="carousel-dot" type="button" data-index="1" aria-pressed="false" aria-label="Imagen 2"></button>
            <button class="carousel-dot" type="button" data-index="2" aria-pressed="false" aria-label="Imagen 3"></button>
          </div>
          <button id="carousel-next" class="carousel-ctrl" aria-label="Imagen siguiente" type="button">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
          <button id="carousel-pause" class="carousel-ctrl" aria-label="Pausar carrusel" aria-pressed="false" type="button">
            <svg class="pause-icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5v14m6-14v14"/></svg>
            <svg class="play-icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m9 5 11 7-11 7z"/></svg>
          </button>
        </div>
      </div>
      <figcaption class="mt-1 flex flex-wrap justify-center gap-x-4 text-center text-xs leading-relaxed font-semibold text-white/85">
        <span>Presencia en todo Norte de Santander</span>
        <span>Reg. Min. Trabajo N°001</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  (function () {
    const carousel = document.getElementById('hero-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    const pauseBtn = document.querySelector<HTMLButtonElement>('#carousel-pause');
    let currentIndex = 0;
    let intervalId: ReturnType<typeof setInterval> | null = null;
    const SLIDE_DURATION = 5000;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let paused = prefersReducedMotion.matches;
    pauseBtn?.setAttribute('aria-pressed', String(paused));

    function showSlide(index: number) {
      if (index >= slides.length) index = 0;
      if (index < 0) index = slides.length - 1;
      currentIndex = index;

      slides.forEach((slide, i) => {
        const active = i === index;
        (slide as HTMLElement).style.opacity = active ? '1' : '0';
        (slide as HTMLElement).style.transform = active ? 'scale(1)' : 'scale(0.96)';
        (slide as HTMLElement).style.zIndex = active ? '10' : '0';
        slide.setAttribute('aria-hidden', String(!active));
      });

      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('active', active);
        dot.setAttribute('aria-pressed', String(active));
      });
    }

    const nextSlide = () => showSlide(currentIndex + 1);
    const prevSlide = () => showSlide(currentIndex - 1);

    function startAutoPlay() {
      if (paused || intervalId !== null || document.hidden || carousel.matches(':hover, :focus-within')) return;
      intervalId = setInterval(nextSlide, SLIDE_DURATION);
    }

    function stopAutoPlay() {
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
    }

    prevBtn?.addEventListener('click', () => { stopAutoPlay(); prevSlide(); startAutoPlay(); });
    nextBtn?.addEventListener('click', () => { stopAutoPlay(); nextSlide(); startAutoPlay(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { stopAutoPlay(); showSlide(i); startAutoPlay(); });
    });

    pauseBtn?.addEventListener('click', () => {
      paused = !paused;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      if (paused) stopAutoPlay();
      else startAutoPlay();
    });

    prefersReducedMotion.addEventListener('change', ({ matches }) => {
      if (matches) {
        paused = true;
        pauseBtn?.setAttribute('aria-pressed', 'true');
        stopAutoPlay();
      }
    });

    carousel.addEventListener('focusin', stopAutoPlay);
    carousel.addEventListener('focusout', () => requestAnimationFrame(startAutoPlay));
    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stopAutoPlay() : startAutoPlay();
    });

    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      if (e.key === 'ArrowLeft') prevSlide();
      else nextSlide();
    });

    showSlide(0);
    startAutoPlay();
  })();
</script>

<style>
  .hero-title {
    font-size: clamp(2.1rem, 4.2vw, 3.85rem);
    line-height: 1.08;
    letter-spacing: -0.047em;
  }

  .hero-title span:last-child {
    margin-top: 0.12em;
    color: var(--gold);
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  #hero-carousel {
    padding: clamp(0.4rem, 1vw, 0.8rem);
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 1.65rem;
    background: rgb(255 255 255 / 6%);
    box-shadow: 0 20px 48px -24px rgb(0 22 13 / 60%);
  }

  #hero-carousel .carousel-frame {
    border-radius: 1.15rem;
  }

  .carousel-controls {
    max-width: 100%;
  }

  .carousel-controls > div {
    min-width: 0;
  }

  .hero-join {
    min-height: 3rem;
    background: #fbbf24;
    color: var(--ui-text);
  }

  .hero-join:hover {
    background: #f59e0b;
  }

  .hero-about {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: 0.375rem;
    color: white;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    transition: color var(--ui-t);
  }

  .hero-about:hover {
    color: #fcd34d;
  }

  .hero .hero-join:focus-visible,
  .hero-about:focus-visible {
    outline-color: #fcd34d;
  }

  .carousel-frame {
    aspect-ratio: 16 / 10;
  }

  @media (min-width: 1024px) {
    .carousel-frame {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 639px) {
    .carousel-controls {
      align-self: center;
    }
  }

  .carousel-ctrl,
  .carousel-dot {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    transition: background var(--ui-t);
  }

  .carousel-ctrl:hover,
  .carousel-dot:hover {
    background: rgb(255 255 255 / 0.14);
  }

  .carousel-dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.65);
  }

  .carousel-dot.active::before {
    width: 18px;
    background: #fcd34d;
  }

  .carousel-controls button:focus-visible {
    outline: 2px solid #fcd34d;
    outline-offset: -3px;
  }

  #carousel-pause[aria-pressed='false'] .play-icon,
  #carousel-pause[aria-pressed='true'] .pause-icon {
    display: none;
  }
</style>
