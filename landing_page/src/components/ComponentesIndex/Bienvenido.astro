---
import { Picture } from 'astro:assets';
import heroPhoto from '../../assets/landing/5.jpg';
import detailPhoto from '../../assets/landing/3.jpg';
import placeholderPhoto from '../../assets/landing/2.jpg';
---

<section class="hero relative isolate overflow-hidden text-white" style="min-height:100svh; background: radial-gradient(ellipse 100% 80% at 20% -10%, #1a5c35 0%, #0a2715 55%, #061a0e 100%);">

  <!-- Textura diagonal sutil -->
  <div class="hero-grid absolute inset-0 pointer-events-none opacity-[0.07]" aria-hidden="true"></div>

  <!-- Orbes de luz ambiental -->
  <div class="absolute top-[-5%] left-[-15%] w-[55rem] h-[55rem] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(22,163,74,0.18) 0%, transparent 70%); filter: blur(60px);" aria-hidden="true"></div>
  <div class="absolute bottom-[-15%] right-[-10%] w-[65rem] h-[65rem] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(251,191,36,0.10) 0%, transparent 70%); filter: blur(80px);" aria-hidden="true"></div>
  <div class="absolute top-[30%] right-[5%] w-[30rem] h-[30rem] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(74,222,128,0.07) 0%, transparent 70%); filter: blur(50px);" aria-hidden="true"></div>

  <!-- Línea decorativa horizontal luminosa -->
  <div class="hero-line absolute top-0 left-0 right-0 h-px pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto grid min-h-[100svh] max-w-7xl items-center gap-10 px-5 pb-20 pt-20 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pt-14">

    <!-- ══ COLUMNA IZQUIERDA ══ -->
    <div class="flex flex-col justify-center">

      <!-- Badge eyebrow -->
      <div class="inline-flex items-center gap-2.5 self-start rounded-full border border-white/20 bg-white/8 px-4 py-2 backdrop-blur-sm mb-7 shadow-lg" style="background: rgba(255,255,255,0.08);">
        <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        <span class="text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-amber-200">
          Sindicato de Trabajadores de la Educación · Norte de Santander
        </span>
      </div>

      <!-- Título principal -->
      <h1 class="hero-title mb-7 text-balance font-extrabold leading-[1.0] tracking-tight">
        <span class="block text-white">Defensa de la Educación,</span>
        <span class="relative mt-1 block">
          <span class="hero-gradient-text">Unidad de los Trabajadores</span>
          <!-- Underline decorativa -->
          <svg class="hero-underline absolute -bottom-2 left-0 w-full overflow-visible" viewBox="0 0 400 12" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 8 Q100 2 200 8 Q300 14 400 8" stroke="url(#ul-grad)" stroke-width="3" fill="none" stroke-linecap="round"/>
            <defs>
              <linearGradient id="ul-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#fbbf24" stop-opacity="0"/>
                <stop offset="30%" stop-color="#fbbf24"/>
                <stop offset="70%" stop-color="#f59e0b"/>
                <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
              </linearGradient>
            </defs>
          </svg>
        </span>
      </h1>

      <p class="mb-10 max-w-lg text-lg leading-relaxed text-white/80 lg:text-xl">
        Unidos defendemos los derechos laborales, el salario justo y la educación pública de calidad para los docentes de Norte de Santander.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <a href="/register.html" class="btn btn-accent group px-8 py-4 text-base font-extrabold tracking-wide shadow-xl shadow-amber-500/20">
          Afíliate a SUTENS
          <svg class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
        <a href="#quienes-somos" class="btn btn-outline-light group px-8 py-4 text-base font-extrabold">
          Conoce la organización
          <svg class="h-5 w-5 transition-transform duration-200 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </a>
      </div>

      <!-- Stats rápidas -->
      <div class="mt-12 grid grid-cols-3 gap-4 max-w-md border-t border-white/10 pt-8">
        <div>
          <p class="text-2xl font-extrabold text-white lg:text-3xl">2016</p>
          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-white/50">Fundados</p>
        </div>
        <div class="border-l border-white/10 pl-4">
          <p class="text-2xl font-extrabold text-amber-300 lg:text-3xl">4</p>
          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-white/50">Subdirectivas</p>
        </div>
        <div class="border-l border-white/10 pl-4">
          <p class="text-2xl font-extrabold text-emerald-300 lg:text-3xl">NdeS</p>
          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-white/50">Departamento</p>
        </div>
      </div>
    </div>

    <!-- ══ COLUMNA DERECHA ══ -->
    <div class="relative flex flex-col items-center justify-center">

      <!-- Anillo decorativo de fondo -->
      <div class="hero-ring absolute -inset-8 rounded-[2.5rem] border border-white/5" aria-hidden="true"></div>
      <div class="hero-ring-2 absolute -inset-4 rounded-[2.5rem]" style="background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(251,191,36,0.03));" aria-hidden="true"></div>

      <!-- Badge flotante superior derecho -->
      <div class="absolute -top-4 -right-2 z-20 flex items-center gap-2 rounded-2xl border border-white/15 px-4 py-2.5 backdrop-blur-md shadow-2xl animate-floating-slow" style="background: rgba(14,30,20,0.75);">
        <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        <span class="text-xs font-extrabold text-white">Organización activa</span>
      </div>

      <!-- Badge flotante izquierdo central -->
      <div class="absolute -left-4 top-1/2 z-20 flex items-center gap-2 rounded-2xl border border-white/15 px-4 py-2.5 backdrop-blur-md shadow-2xl animate-floating-fast" style="background: rgba(14,30,20,0.75);">
        <span class="text-base" aria-hidden="true">🏛️</span>
        <span class="text-xs font-extrabold text-white">Reg. Min. Trabajo N°001</span>
      </div>

      <!-- Carrusel de imágenes -->
      <div id="hero-carousel" class="relative w-full overflow-hidden rounded-[2rem] shadow-2xl" style="height: 30rem; box-shadow: 0 40px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08);">

        <!-- Imagen 1 -->
        <div class="carousel-slide absolute inset-0 opacity-100 scale-100 z-10 transition-all duration-700 ease-in-out" data-index="0" aria-hidden="false">
          <Picture
            src={heroPhoto}
            alt="Actividad sindical de SUTENS en Norte de Santander"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 600, 800, 1024]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            quality={85}
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#061a0e]/70 via-transparent to-transparent" aria-hidden="true"></div>
        </div>

        <!-- Imagen 2 -->
        <div class="carousel-slide absolute inset-0 opacity-0 scale-95 z-0 transition-all duration-700 ease-in-out" data-index="1" aria-hidden="true">
          <Picture
            src={placeholderPhoto}
            alt="Afiliados de SUTENS en Norte de Santander"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 600, 800]}
            sizes="(min-width: 768px) 33vw, 90vw"
            loading="lazy"
            decoding="async"
            quality={85}
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#061a0e]/70 via-transparent to-transparent" aria-hidden="true"></div>
        </div>

        <!-- Imagen 3 -->
        <div class="carousel-slide absolute inset-0 opacity-0 scale-95 z-0 transition-all duration-700 ease-in-out" data-index="2" aria-hidden="true">
          <Picture
            src={detailPhoto}
            alt="Encuentro de trabajadores de la educación de SUTENS"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[320, 480, 640]}
            sizes="(min-width: 640px) 25vw, 90vw"
            loading="lazy"
            decoding="async"
            quality={80}
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#061a0e]/70 via-transparent to-transparent" aria-hidden="true"></div>
        </div>

        <!-- Controles del carrusel -->
        <div class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 items-center gap-3">
          <button id="carousel-prev" class="carousel-ctrl" aria-label="Imagen anterior" type="button">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div class="flex items-center gap-1.5" role="tablist" aria-label="Indicadores">
            <button class="carousel-dot w-2 h-2 rounded-full" data-index="0" role="tab" aria-selected="true" aria-label="Imagen 1"></button>
            <button class="carousel-dot w-2 h-2 rounded-full" data-index="1" role="tab" aria-selected="false" aria-label="Imagen 2"></button>
            <button class="carousel-dot w-2 h-2 rounded-full" data-index="2" role="tab" aria-selected="false" aria-label="Imagen 3"></button>
          </div>
          <button id="carousel-next" class="carousel-ctrl" aria-label="Imagen siguiente" type="button">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- Etiqueta inferior del carrusel -->
      <p class="mt-3 text-center text-xs font-semibold uppercase tracking-widest text-white/40">Presencia en todo Norte de Santander</p>
    </div>
  </div>

  <!-- Ola inferior más dramática -->
  <div class="absolute bottom-0 left-0 right-0 h-28 overflow-hidden" aria-hidden="true">
    <svg viewBox="0 0 1440 112" preserveAspectRatio="none" class="w-full h-full">
      <path d="M0 56 C240 112 480 0 720 56 C960 112 1200 0 1440 56 L1440 112 L0 112 Z" fill="#f6faf7" opacity="0.08"/>
      <path d="M0 70 C360 20 720 100 1080 50 C1260 25 1360 65 1440 70 L1440 112 L0 112 Z" fill="#f6faf7"/>
    </svg>
  </div>
</section>

<script>
  (function () {
    const carousel = document.getElementById('hero-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.carousel-slide');
    const dots = carousel.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    let currentIndex = 0;
    let intervalId: ReturnType<typeof setInterval> | null = null;
    const SLIDE_DURATION = 5000;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function showSlide(index: number) {
      if (index >= slides.length) index = 0;
      if (index < 0) index = slides.length - 1;
      currentIndex = index;

      slides.forEach((slide, i) => {
        const active = i === index;
        (slide as HTMLElement).style.opacity = active ? '1' : '0';
        (slide as HTMLElement).style.transform = active ? 'scale(1)' : 'scale(0.96)';
        (slide as HTMLElement).style.zIndex = active ? '10' : '0';
        slide.setAttribute('aria-hidden', String(!active));
      });

      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('active', active);
        dot.setAttribute('aria-selected', String(active));
      });
    }

    const nextSlide = () => showSlide(currentIndex + 1);
    const prevSlide = () => showSlide(currentIndex - 1);

    function startAutoPlay() {
      if (prefersReducedMotion) return;
      intervalId = setInterval(nextSlide, SLIDE_DURATION);
    }

    function stopAutoPlay() {
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
    }

    prevBtn?.addEventListener('click', () => { stopAutoPlay(); prevSlide(); startAutoPlay(); });
    nextBtn?.addEventListener('click', () => { stopAutoPlay(); nextSlide(); startAutoPlay(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { stopAutoPlay(); showSlide(i); startAutoPlay(); });
    });

    carousel.addEventListener('mouseenter', stopAutoPlay);
    carousel.addEventListener('mouseleave', startAutoPlay);
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stopAutoPlay() : startAutoPlay();
    });

    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') { stopAutoPlay(); prevSlide(); startAutoPlay(); }
      else if (e.key === 'ArrowRight') { stopAutoPlay(); nextSlide(); startAutoPlay(); }
    });

    showSlide(0);
    startAutoPlay();
  })();
</script>

<style>
  /* ── Tipografía del hero ── */
  .hero-title {
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 1.0;
  }

  .hero-gradient-text {
    background: linear-gradient(110deg, #fbbf24 0%, #fcd34d 40%, #f59e0b 80%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    animation: grad-shift 4s linear infinite;
  }

  .hero-underline {
    height: 12px;
    display: block;
  }

  /* ── Textura de cuadrícula diagonal ── */
  .hero-grid {
    background-image:
      linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  /* ── Línea luminosa superior ── */
  .hero-line {
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(251,191,36,0.6) 30%,
      rgba(74,222,128,0.4) 60%,
      transparent 100%
    );
    animation: line-shimmer 4s ease-in-out infinite;
  }

  /* ── Carrusel ── */
  .carousel-slide {
    will-change: opacity, transform;
  }

  .carousel-ctrl {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(8px);
    transition: background 200ms ease, transform 150ms ease;
  }

  .carousel-ctrl:hover {
    background: rgba(255,255,255,0.22);
    transform: scale(1.1);
  }

  .carousel-dot {
    background: rgba(255,255,255,0.35);
    border-radius: 999px;
    transition: background 250ms ease, width 250ms ease;
  }

  .carousel-dot.active {
    background: #fff;
    width: 20px !important;
  }

  /* ── Animaciones ── */
  @keyframes grad-shift {
    0%   { background-position: 0% center; }
    50%  { background-position: 100% center; }
    100% { background-position: 0% center; }
  }

  @keyframes line-shimmer {
    0%, 100% { opacity: 0.5; }
    50%       { opacity: 1; }
  }

  @keyframes floating-slow {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  @keyframes floating-fast {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-6px); }
  }

  .animate-floating-slow { animation: floating-slow 4s ease-in-out infinite; }
  .animate-floating-fast { animation: floating-fast 3s ease-in-out infinite; }

  /* Shimmer del botón CTA */
  .btn-accent {
    position: relative;
    overflow: hidden;
  }
  .btn-accent::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
    transform: translateX(-100%);
    transition: transform 0.55s ease;
  }
  .btn-accent:hover::before {
    transform: translateX(100%);
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    #hero-carousel { height: 20rem !important; }
  }

  @media (max-width: 767px) {
    .hero-title { font-size: clamp(2.2rem, 8vw, 3rem); }
    #hero-carousel { height: 17rem !important; }
  }

  /* ── Movimiento reducido ── */
  @media (prefers-reduced-motion: reduce) {
    .carousel-slide,
    .hero-gradient-text,
    .hero-line,
    .animate-floating-slow,
    .animate-floating-fast,
    .btn-accent::before { animation: none !important; transition: none !important; }
  }
</style>
