---
import Icono from './Icono.astro';
import {
  pasosAfiliacion,
  documentosRequeridos,
  informacionAfiliacion,
} from '../../data/afiliacion.js';
---

<section id="afiliacion" class="bg-cream px-4 pb-20 pt-10 sm:px-6 sm:pb-28">
  <div class="mx-auto max-w-6xl">

    <!-- Tarjeta principal envolvente del proceso -->
    <div class="relative overflow-hidden rounded-[2.5rem] border border-line border-t-4 border-t-brand-700 bg-verde-suave p-6 text-ink shadow-[var(--ui-sombra-3)] sm:p-10 lg:p-14">
      <div class="hero-pattern opacity-25" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full border border-line" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-20 h-72 w-72 rounded-full bg-brand-600/10 blur-3xl" aria-hidden="true"></div>

      <!-- Cabecera de la sección -->
      <header class="relative max-w-3xl reveal">
        <p class="eyebrow text-brand-700">Paso a paso</p>
        <h2 class="display mt-3 text-3xl sm:text-4xl lg:text-5xl">
          Cómo afiliarte a SUTENS
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
          Únete a la organización sindical que defiende tus derechos en Norte de Santander. El trámite es claro, gratuito y consta de 3 sencillos pasos:
        </p>
      </header>

      <!-- 3 Pasos conectados -->
      <div class="relative mt-12 grid gap-6 md:grid-cols-3 reveal" style="--reveal-delay: 80ms">
        <!-- Conector horizontal visible en pantallas medianas y grandes -->
        <div class="pointer-events-none absolute left-[15%] right-[15%] top-12 hidden h-0.5 border-t-2 border-dashed border-line md:block" aria-hidden="true"></div>

        {pasosAfiliacion.map((paso, idx) => (
          <article class="relative flex flex-col rounded-2xl border border-line bg-white p-6 backdrop-blur-md transition duration-300 hover:border-amber-300/40 hover:bg-white">
            <div class="flex items-center justify-between gap-3">
              <span class="relative z-10 grid h-12 w-12 place-items-center rounded-2xl bg-accent font-extrabold text-ink shadow-md ring-4 ring-white">
                {paso.numero}
              </span>
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-verde-suave text-brand-700">
                <Icono name={paso.icono} class="h-5 w-5" />
              </span>
            </div>

            <h3 class="mt-6 text-xl font-extrabold text-ink">
              {paso.titulo}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              {paso.descripcion}
            </p>

            {paso.enlace && (
              <a
                href={paso.enlace.url}
                download={paso.enlace.download}
                target={paso.enlace.external ? '_blank' : undefined}
                rel={paso.enlace.external ? 'noopener noreferrer' : undefined}
                class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-brand-900 transition hover:underline"
              >
                {paso.enlace.texto}
                <Icono name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            )}
          </article>
        ))}
      </div>

      <!-- Barra de botones de acción principales -->
      <div class="relative mt-10 flex flex-wrap items-center gap-3.5 border-t border-line pt-8 reveal" style="--reveal-delay: 140ms">
        <a href={informacionAfiliacion.registroEnLineaUrl} class="btn btn-accent flex items-center gap-2">
          Afíliate ahora
          <Icono name="arrow-right" class="h-4 w-4" />
        </a>
        <a href={informacionAfiliacion.formularioPdfUrl} download class="btn btn-outline flex items-center gap-2">
          <Icono name="download" class="h-4 w-4" />
          Descargar formulario PDF
        </a>
        <a
          href={informacionAfiliacion.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline inline-flex items-center gap-2"
        >
          <Icono name="whatsapp" class="h-4 w-4 text-brand-700" />
          Escríbenos por WhatsApp
        </a>
      </div>

      <!-- Bloque: ¿Qué necesitas? (Documentos requeridos) -->
      <div class="relative mt-12 rounded-2xl border border-line bg-white p-6 sm:p-8 reveal" style="--reveal-delay: 180ms">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-widest text-brand-700">Requisitos</p>
            <h3 class="mt-1 text-2xl font-extrabold text-ink">¿Qué necesitas para afiliarte?</h3>
          </div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-verde-suave px-3.5 py-1 text-xs font-semibold text-muted">
            <Icono name="check-circle" class="h-3.5 w-3.5 text-brand-700" />
            4 documentos básicos
          </span>
        </div>

        <p class="mt-3 text-sm text-muted">
          Para formalizar tu afiliación a SUTENS debes adjuntar la siguiente documentación:
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {documentosRequeridos.map((doc, i) => (
            <div class="flex items-start gap-3.5 rounded-xl border border-line bg-white p-3.5">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-amber-400/20 text-xs font-extrabold text-brand-700">
                {i + 1}
              </span>
              <div class="min-w-0">
                <h4 class="text-sm font-bold text-ink">{doc.nombre}</h4>
                <p class="mt-0.5 text-sm text-muted">{doc.detalle}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-5 rounded-xl border border-amber-300/30 bg-amber-400/10 p-3 text-xs font-medium text-brand-900">
          El formulario oficial indica una cuota mensual del {informacionAfiliacion.cuotaSindical.porcentajeSalarioBasico} % del salario básico.
        </p>

        <div class="mt-6 flex flex-col gap-3 border-t border-line pt-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
          <p class="flex items-center gap-1.5">
            <Icono name="map-pin" class="h-4 w-4 shrink-0 text-brand-700" />
            <span>Entrega física en: <strong class="text-ink">{informacionAfiliacion.sedeFisica}</strong> o con tu delegado municipal.</span>
          </p>
          <p class="shrink-0">
            ¿Ya eres afiliado?{' '}
            <a href="/login.html" class="font-extrabold text-brand-700 underline underline-offset-2 hover:text-brand-900">
              Inicia sesión aquí
            </a>
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
