---
import { Picture } from 'astro:assets';
import aboutPhoto from '../../assets/landing/3.jpg';
import Icono from './Icono.astro';

const principios = [
  'La independencia de clase',
  'La democracia sindical',
  'La solidaridad de clase',
  'La unidad de acción',
  'La unidad sindical',
];
---

<section id="quienes-somos" class="relative overflow-hidden bg-[#f6faf7] px-4 pt-24 pb-32 sm:px-6 sm:pb-40">
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -right-40 top-40 h-80 w-80 rounded-full bg-brand-700/[0.08] blur-[100px]" aria-hidden="true"></div>
    <div class="absolute -left-40 bottom-40 h-72 w-72 rounded-full bg-brand-900/[0.06] blur-[80px]" aria-hidden="true"></div>
  </div>

  <div class="relative mx-auto max-w-6xl">
    <header class="max-w-3xl mx-auto text-center reveal mb-20">
      <p class="eyebrow inline-flex items-center gap-2 text-brand-700 mb-3">
        <span class="h-1 w-1 rounded-full bg-brand-700"></span>
        Quiénes somos
      </p>
      <h2 class="display mb-6 text-3xl tracking-tight text-ink sm:text-5xl lg:text-6xl">
        Una organización que defiende la educación pública
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted max-w-2xl mx-auto">
        SUTENS agrupa a docentes, directivos docentes y administrativos de Norte de Santander. Somos una organización sindical de primer grado que trabaja por la dignificación de la labor educativa y por la unidad de los trabajadores.
      </p>
    </header>

    <div class="mt-16 grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="reveal">
        <div class="relative group">
          <div class="absolute -inset-3 rounded-[2.5rem] bg-brand-700/[0.08] sm:-inset-5" aria-hidden="true"></div>
          <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
            <div class="h-full overflow-hidden rounded-1.5xl">
              <Picture
                src={aboutPhoto}
                alt="Integrantes de SUTENS reunidos en una actividad sindical"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[420, 640, 860]}
                sizes="(min-width: 1024px) 42vw, 92vw"
                loading="lazy"
                decoding="async"
                quality={82}
                class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>
          </div>
        </div>

        <div class="absolute -bottom-8 left-0 flex items-center gap-3 rounded-2xl border border-slate-200 bg-white/95 px-5 py-4 shadow-xl backdrop-blur-sm sm:left-8">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-900 text-white">
            <Icono name="book" class="h-5 w-5" />
          </span>
          <span class="leading-tight">
            <strong class="block text-sm font-extrabold text-ink">Desde 2016</strong>
            <span class="text-xs font-semibold text-muted">Norte de Santander</span>
          </span>
        </div>
      </div>

      <div class="reveal" style="--reveal-delay: 80ms">
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <span class="h-12 w-12 shrink-0 rounded-2xl bg-brand-900/10 flex-shrink-0 grid place-items-center">
              <Icono name="book" class="h-6 w-6 text-brand-900" />
            </span>
            <div>
              <h3 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">Nuestra historia</h3>
              <p class="mt-2 text-sm font-semibold text-muted">Fundado en 2016</p>
            </div>
          </div>

          <p class="mt-6 leading-relaxed text-muted">
            El Sindicato Unitario de Trabajadores de la Educación Norte de Santander (SUTENS) es una organización sindical de primer grado que agrupa a docentes, directivos docentes y administrativos que laboran en el Departamento de Norte de Santander en los diferentes niveles educativos.
          </p>

          <p class="mt-6 leading-relaxed text-muted">
            SUTENS se conformó el 29 de junio de 2016 cuando un grupo de docentes de los municipios de El Tarra y Teorama se unieron haciendo uso del derecho constitucional de asociación, agremiándose sindicalmente para luchar en la defensa de los derechos e intereses de los docentes.
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/Nosotros/" class="group flex items-center gap-3 px-5 py-3 rounded-2xl border border-brand-900 bg-brand-900 text-white shadow-xl transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]">
              Conoce la directiva
              <Icono name="arrow-right" class="h-4 w-4 text-[#fbbf24]" />
            </a>
            <a href="/Secretarias/" class="group flex items-center gap-3 px-5 py-3 rounded-2xl border border-brand-900 bg-white text-brand-900 shadow-lg transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]">
              Ver subdirectivas
              <Icono name="arrow-right" class="h-4 w-4 text-brand-900" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-24 grid gap-6 lg:grid-cols-3">
      {principios.map((principio, index) => (
        <article class="group p-8 rounded-2xl border border-slate-200 bg-white shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-xl active:scale-[0.98] reveal" style={`--reveal-delay: ${index * 60}ms`}>
          <span class="grid h-14 w-14 place-items-center rounded-3xl bg-verde-suave text-brand-700 shadow-sm">
            <Icono name="check" class="h-7 w-7" />
          </span>
          <h4 class="mt-6 text-lg font-extrabold text-ink">{principio}</h4>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .about-photo picture,
  .about-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>