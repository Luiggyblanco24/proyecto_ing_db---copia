---
import { aliados } from '../../data/aliados.js';

// Regla estricta: La sección permanece 100% oculta hasta que se entregue la lista confirmada
const tieneAliados = Array.isArray(aliados) && aliados.length > 0;
---

{tieneAliados && (
  <section id="aliados" class="bg-white px-4 py-16 sm:px-6 sm:py-20" aria-labelledby="aliados-titulo">
    <div class="mx-auto max-w-6xl text-center">
      <header class="max-w-2xl mx-auto mb-10 reveal">
        <p class="eyebrow text-brand-700">Respaldo y articulación</p>
        <h2 id="aliados-titulo" class="display mt-3 text-3xl text-ink sm:text-4xl">
          Organizaciones aliadas
        </h2>
        <p class="mt-3 text-sm text-muted">
          Articulación gremial e institucional en beneficio de la comunidad educativa.
        </p>
      </header>

      <div class="flex flex-wrap items-center justify-center gap-6 reveal" style="--reveal-delay: 80ms">
        {aliados.map((aliado) => (
          <div class="flex items-center gap-3 rounded-2xl border border-line bg-cream p-4 shadow-sm">
            {aliado.logoUrl && (
              <img src={aliado.logoUrl} alt={aliado.nombre} class="h-10 w-auto object-contain" loading="lazy" />
            )}
            <div class="text-left">
              <p class="text-sm font-extrabold text-ink">{aliado.nombre}</p>
              {aliado.sigla && <p class="text-xs font-semibold text-brand-700">{aliado.sigla}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
