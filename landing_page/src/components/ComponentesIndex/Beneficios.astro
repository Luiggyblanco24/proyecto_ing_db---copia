---
import { Picture } from 'astro:assets';
import imagenDerechos from '../../assets/landing/1.jpg';
import imagenAsesoria from '../../assets/landing/2.jpg';
import imagenCapacitacion from '../../assets/landing/3.jpg';
import imagenParticipacion from '../../assets/landing/5.jpg';
import imagenSede from '../../assets/landing/6.jpg';

const beneficios = [
  {
    icon: 'shield',
    imageUrl: imagenDerechos,
    title: 'Defensa de los derechos laborales',
    description: 'Protección de los derechos laborales y condiciones de trabajo justas para todos los afiliados.',
    color: 'text-amber-700'
  },
  {
    icon: 'check',
    imageUrl: imagenAsesoria,
    title: 'Asesoría legal gratuita',
    description: 'Asesoría profesional en temas laborales y derechos sindicales sin costo.',
    color: 'text-primary'
  },
  {
    icon: 'briefcase',
    imageUrl: imagenCapacitacion,
    title: 'Capacitación y desarrollo profesional',
    description: 'Cursos y talleres para mejorar competencias profesionales y liderazgo.',
    color: 'text-primary'
  },
  {
    icon: 'calendar',
    imageUrl: imagenParticipacion,
    title: 'Participación activa',
    description: 'Asambleas, conferencias y actividades para mantener el diálogo sindical.',
    color: 'text-primary'
  },
  {
    icon: 'map-pin',
    imageUrl: imagenSede,
    title: 'Sede y presencia territorial',
    description: 'Sede central en Cali y delegaciones en todo el departamento de Norte de Santander.',
    color: 'text-primary'
  },
];
---

<section id="beneficios" class="relative overflow-hidden bg-[#f6faf7] px-4 pt-24 pb-32 sm:px-6 sm:pb-40">
  <div class="max-w-6xl mx-auto">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {beneficios.map((beneficio, index) => (
        <article class="group p-8 rounded-2xl border border-slate-200 bg-white shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-xl reveal" style={`--reveal-delay: ${index * 50}ms`}>
          <div class="relative aspect-[4/3] overflow-hidden">
            <Picture
              src={beneficio.imageUrl}
              alt={beneficio.title}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[400, 600, 800]}
              sizes="(min-width: 768px) 33vw, 90vw"
              loading="lazy"
              decoding="async"
              quality={82}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-700/40 via-brand-700/20 to-transparent" aria-hidden="true"></div>
          </div>
          <div class="relative z-10">
            <h3 class="text-2xl font-extrabold tracking-tight text-ink mb-4">{beneficio.title}</h3>
            <p class="text-base leading-relaxed text-muted">{beneficio.description}</p>
            <a href="/beneficios" class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-primary transition-colors hover:text-primary/80">
              Saber más
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>