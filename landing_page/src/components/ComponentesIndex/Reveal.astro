<script>
  const portada = document.querySelector<HTMLElement>('.sutens-home');
  const pie = document.querySelector('footer');
  const columnas = pie?.querySelectorAll('[data-footer-column]');
  columnas?.forEach((columna) => columna.classList.add('reveal'));

  if ('IntersectionObserver' in window && portada) {
    const observar = new IntersectionObserver((entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        entrada.target.classList.replace('reveal-pending', 'is-visible');
        observar.unobserve(entrada.target);
      }
    }, { rootMargin: '0px 0px -4% 0px' });

    function registrar(elemento: Element) {
      elemento.classList.add('reveal-pending');
      observar.observe(elemento);
    }

    portada.querySelectorAll('.reveal').forEach(registrar);
    columnas?.forEach(registrar);

    // Las publicaciones se incorporan al terminar la consulta a la API.
    const documentos = document.getElementById('documentos-grid');
    if (documentos) {
      new MutationObserver((cambios) => {
        for (const cambio of cambios) {
          for (const nodo of cambio.addedNodes) {
            if (!(nodo instanceof Element)) continue;
            if (nodo.matches('.reveal')) registrar(nodo);
            nodo.querySelectorAll('.reveal').forEach(registrar);
          }
        }
      }).observe(documentos, { childList: true });
    }
  }

  const punteroPreciso = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  portada?.addEventListener('pointermove', (evento: PointerEvent) => {
    if (!punteroPreciso.matches || !(evento.target instanceof Element)) return;
    const tarjeta = evento.target.closest('article');
    if (!tarjeta) return;
    const limites = tarjeta.getBoundingClientRect();
    tarjeta.style.setProperty('--halo-x', (evento.clientX - limites.left) + 'px');
    tarjeta.style.setProperty('--halo-y', (evento.clientY - limites.top) + 'px');
  }, { passive: true });

  const enlacesNav = Array.from(document.querySelectorAll('[data-nav-section]'));
  if (enlacesNav.length > 0) {
    const secciones = enlacesNav
      .map((enlace) => document.getElementById(enlace.dataset.navSection))
      .filter(Boolean);

    let pendiente = false;

    function actualizarNav() {
      pendiente = false;
      const limite = window.scrollY + 150;
      let actual = '';

      for (const seccion of secciones) {
        if (seccion.offsetTop <= limite) actual = seccion.id;
      }

      enlacesNav.forEach((enlace) => {
        const activo = enlace.dataset.navSection === actual;
        enlace.classList.toggle('is-active', activo);
        if (activo) enlace.setAttribute('aria-current', 'location');
        else enlace.removeAttribute('aria-current');
      });
    }

    function alDesplazar() {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(actualizarNav);
    }

    actualizarNav();
    window.addEventListener('scroll', alDesplazar, { passive: true });
    window.addEventListener('resize', alDesplazar, { passive: true });
  }
</script>
