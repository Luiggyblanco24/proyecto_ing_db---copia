<div class="mx-auto max-w-6xl">
  <div class="text-center mb-12">
    <span class="inline-block rounded-full bg-verde-suave px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-brand-700 mb-3">
      Identidad institucional
    </span>
    <h2 class="text-3xl font-extrabold text-ink sm:text-4xl">
      Nuestros Pilares Fundamentales
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Misión -->
    <div class="group flex flex-col rounded-3xl border border-line bg-cream p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-600/40 hover:bg-white hover:shadow-lg">
      <div class="mb-5 grid h-14 w-14 place-items-center rounded-2xl bg-brand-900 text-amber-400 shadow-sm">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
        </svg>
      </div>
      <h3 class="text-xl font-extrabold text-ink mb-3">Misión</h3>
      <p class="text-sm text-muted leading-relaxed flex-1">
        Promover y proteger los derechos laborales e intereses de nuestros miembros en materia salarial, prestaciones y condiciones de trabajo mediante la negociación colectiva, la representación activa y la defensa de sus derechos, garantizando un ambiente laboral justo, equitativo y seguro para todos los afiliados.
      </p>
    </div>

    <!-- Visión -->
    <div class="group flex flex-col rounded-3xl border border-line bg-cream p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-600/40 hover:bg-white hover:shadow-lg">
      <div class="mb-5 grid h-14 w-14 place-items-center rounded-2xl bg-brand-900 text-amber-400 shadow-sm">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
      <h3 class="text-xl font-extrabold text-ink mb-3">Visión</h3>
      <p class="text-sm text-muted leading-relaxed flex-1">
        Para el año 2030, SUTENS será reconocido como sindicato líder en la defensa del bien común, donde todos los afiliados se benefician de manera equitativa, estableciendo estándares de desarrollo sostenible en el ambiente laboral y social del departamento.
      </p>
    </div>

    <!-- Principios sindicales -->
    <div class="group flex flex-col rounded-3xl border border-line bg-cream p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-600/40 hover:bg-white hover:shadow-lg">
      <div class="mb-5 grid h-14 w-14 place-items-center rounded-2xl bg-brand-900 text-amber-400 shadow-sm">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </div>
      <h3 class="text-xl font-extrabold text-ink mb-3">Principios sindicales</h3>
      <ul class="space-y-2.5 flex-1">
        {[
          'La independencia de clase',
          'La democracia sindical',
          'La solidaridad de clase',
          'La unidad de acción',
          'La unidad sindical',
        ].map((principio) => (
          <li class="flex items-start gap-2.5 text-sm text-muted">
            <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-900">
              <svg class="h-2.5 w-2.5 text-amber-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M2 6l3 3 5-5"/>
              </svg>
            </span>
            {principio}
          </li>
        ))}
      </ul>
    </div>

  </div>
</div>
