---
import Historia from "./Historia.astro";
import MisionVision from "./MisionVision.astro";
import EquipoDirectivo from "./EquipoDirectivo.astro";
---

<!-- Hero Section -->
<section class="relative px-4 pb-12 pt-32 text-center sm:pb-16">
    <div class="container mx-auto">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-[#1b7a38]">Organización sindical</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Sobre SUTENS</h1>
        <p class="mx-auto max-w-3xl text-xl text-[#475569]">
            Sindicato Unitario de Trabajadores de la Educación de Norte de Santander. Defensa de la Educación, Unidad de los Trabajadores.
        </p>
    </div>
</section>

<section class=" px-4">
    <Historia />
</section>

<!-- Sección Misión, Visión y Valores -->
<section class="py-16 bg-secondary px-4">
    <MisionVision />
</section>

<section class="py-16 bg-secondary px-4">
    <EquipoDirectivo />
</section>

<section class="py-16 bg-[#1b7a38] text-white">
    <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-3xl font-bold mb-6">
            ¿Quieres conocer más sobre SUTENS?
        </h2>
        <p class="text-xl mb-8">
            Contáctanos para obtener más información sobre nuestra labor y cómo
            podemos ayudarte.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
                href="/register.html"
                class="rounded-lg bg-[#f59e0b] px-6 py-3 font-semibold text-[#1e293b] shadow-md transition-all hover:bg-[#d97706]"
            >
                Afíliate en línea
            </a>
        </div>
    </div>
</section>
