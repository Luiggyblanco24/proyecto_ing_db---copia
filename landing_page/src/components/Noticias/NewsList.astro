---
import { Picture } from 'astro:assets';
import { news } from '../../lib/local-data.js';

const formattedNews = news.map((item) => ({
  ...item,
  date: new Date(item.publishedAt).toLocaleDateString('es-CO', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }),
}));
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {formattedNews.map((item) => (
    <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-xl">
      <div class="relative aspect-[4/3] overflow-hidden">
        <Picture
          src={item.imageUrl}
          alt={item.title}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[400, 600, 800]}
          sizes="(min-width: 768px) 33vw, 100vw"
          loading="lazy"
          decoding="async"
          quality={82}
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 transition duration-300 group-hover:opacity-100" />
      </div>
      <div class="p-5">
        <time class="text-xs font-semibold uppercase tracking-wider text-primary">{item.date}</time>
        <h3 class="mt-2 text-lg font-extrabold leading-snug text-ink transition-colors group-hover:text-primary">{item.title}</h3>
        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{item.description}</p>
        <a
          href={`/news/${item.id}`}
          class="mt-4 inline-flex items-center gap-2 text-sm font-extrabold text-primary transition-colors hover:text-primary/80"
        >
          Leer más
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </article>
  ))}
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>