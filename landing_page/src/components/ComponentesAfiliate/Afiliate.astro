---
import Icono from '../ComponentesIndex/Icono.astro';
import { datosContacto } from '../../data/contacto.js';
---

<!-- Hero institucional Afíliate -->
<header class="relative isolate overflow-hidden bg-gradient-to-b from-[#0a2715] via-[#103d22] to-[#15803d] pb-16 pt-32 text-white sm:pb-20 sm:pt-40">
  <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-20 bottom-0 h-80 w-80 rounded-full bg-emerald-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 text-center sm:px-6">
    <span class="inline-flex items-center gap-2 rounded-full border border-amber-300/30 bg-amber-400/10 px-4 py-1.5 text-xs font-extrabold uppercase tracking-widest text-amber-300 mb-4 shadow-sm">
      <span class="h-2 w-2 rounded-full bg-amber-400" aria-hidden="true"></span>
      Proceso de afiliación
    </span>

    <h1 class="text-3xl font-extrabold sm:text-4xl md:text-5xl lg:text-6xl text-balance">
      ¡Afíliate a SUTENS!
    </h1>

    <p class="mx-auto mt-4 max-w-2xl text-base text-white/85 sm:text-lg text-balance">
      Forma parte de la organización sindical que defiende los derechos laborales de los trabajadores de la educación de Norte de Santander.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/register.html"
        class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-7 py-3 font-extrabold text-[#1e293b] shadow-lg transition hover:bg-amber-300 hover:scale-105"
      >
        Afiliarme en línea
      </a>
      <a
        href="/Formatodeafiliacionsutens.pdf"
        download
        class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3 font-extrabold text-white backdrop-blur-sm transition hover:bg-white/20 hover:scale-105"
      >
        <Icono name="download" class="h-4 w-4" />
        Descargar formulario
      </a>
    </div>
  </div>
</header>

<!-- Contenido principal -->
<main class="bg-cream px-4 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">

    <!-- Banner de acceso rápido -->
    <div class="mb-12 flex flex-col items-center justify-between gap-5 rounded-3xl border border-line bg-white p-6 shadow-sm sm:flex-row sm:p-8">
      <div>
        <h2 class="text-xl font-extrabold text-ink">Elige cómo iniciar tu afiliación</h2>
        <p class="mt-1 text-sm text-muted">Puedes completar el registro en línea o descargar el formulario oficial e imprimirlo.</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href="/register.html" class="btn btn-primary text-center">Afiliarme en línea</a>
        <a href="/Formatodeafiliacionsutens.pdf" download class="btn btn-outline text-center">Descargar formulario</a>
      </div>
    </div>

    <!-- Columnas -->
    <div class="flex flex-col lg:flex-row gap-8">

      <!-- Pasos del proceso -->
      <div class="lg:w-2/3 rounded-3xl border border-line bg-white p-6 shadow-sm md:p-10">
        <span class="inline-block rounded-full bg-verde-suave px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-brand-700 mb-4">Paso a paso</span>
        <h2 class="text-2xl font-extrabold text-ink mb-8">Proceso de afiliación</h2>

        <ol class="relative border-l-2 border-emerald-600/20 space-y-8 pl-8">

          <!-- Paso 1 -->
          <li class="relative">
            <span class="absolute -left-[2.65rem] flex h-9 w-9 items-center justify-center rounded-full bg-brand-900 text-white font-extrabold text-sm shadow-sm ring-4 ring-cream">1</span>
            <h3 class="text-lg font-extrabold text-ink mb-1">Descarga el formulario</h3>
            <p class="text-sm text-muted mb-3">Obtén el formulario de afiliación en formato PDF listo para imprimir y diligenciar.</p>
            <a
              href="/Formatodeafiliacionsutens.pdf"
              download
              class="inline-flex items-center gap-2 rounded-full bg-brand-900 px-5 py-2 text-sm font-extrabold text-white shadow-sm transition hover:bg-brand-700 hover:scale-105"
            >
              <Icono name="download" class="h-4 w-4" />
              Descargar formato PDF
            </a>
          </li>

          <!-- Paso 2 -->
          <li class="relative">
            <span class="absolute -left-[2.65rem] flex h-9 w-9 items-center justify-center rounded-full bg-brand-900 text-white font-extrabold text-sm shadow-sm ring-4 ring-cream">2</span>
            <h3 class="text-lg font-extrabold text-ink mb-1">Completa la información</h3>
            <p class="text-sm text-muted mb-3">Llena todos los campos del formulario con tus datos personales y laborales:</p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {['Datos personales completos', 'Información de contacto', 'Datos laborales', 'Firma y fecha'].map((item) => (
                <li class="flex items-center gap-2 text-sm text-muted">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-900">
                    <svg class="h-2.5 w-2.5 text-amber-400" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M2 6l3 3 5-5"/>
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </li>

          <!-- Paso 3 -->
          <li class="relative">
            <span class="absolute -left-[2.65rem] flex h-9 w-9 items-center justify-center rounded-full bg-brand-900 text-white font-extrabold text-sm shadow-sm ring-4 ring-cream">3</span>
            <h3 class="text-lg font-extrabold text-ink mb-1">Entrega el formulario</h3>
            <p class="text-sm text-muted mb-3">Puedes entregarlo presencialmente en nuestra sede o enviarlo por WhatsApp:</p>
            <div class="rounded-2xl border border-line bg-cream p-4 text-sm space-y-1">
              <p class="font-semibold text-ink">📍 Sede principal</p>
              <p class="text-muted">{datosContacto.sede.direccion}, {datosContacto.sede.ciudad}</p>
              <p class="text-muted mt-1">También puedes consultar por
                <a href={datosContacto.canales.whatsapp.url} target="_blank" rel="noopener noreferrer" class="text-brand-700 font-bold hover:underline"> WhatsApp</a>.
              </p>
            </div>
          </li>

          <!-- Paso 4 -->
          <li class="relative">
            <span class="absolute -left-[2.65rem] flex h-9 w-9 items-center justify-center rounded-full bg-amber-400 text-[#1e293b] font-extrabold text-sm shadow-sm ring-4 ring-cream">✓</span>
            <h3 class="text-lg font-extrabold text-ink mb-1">¡Listo! Eres parte de SUTENS</h3>
            <p class="text-sm text-muted">
              Una vez procesada tu afiliación recibirás confirmación. Si tienes dudas, contáctanos por nuestros canales oficiales.
            </p>
          </li>

        </ol>
      </div>

      <!-- Columna lateral -->
      <div class="lg:w-1/3 flex flex-col gap-6">

        <!-- ¿Por qué afiliarte? -->
        <div class="rounded-3xl border border-line bg-white p-6 shadow-sm md:p-8">
          <span class="inline-block rounded-full bg-verde-suave px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-brand-700 mb-4">Beneficios</span>
          <h2 class="text-xl font-extrabold text-ink mb-5">¿Por qué afiliarte?</h2>
          <ul class="space-y-3">
            {[
              { icon: '🛡️', texto: 'Defensa de tus derechos laborales' },
              { icon: '🤝', texto: 'Negociación colectiva' },
              { icon: '⚖️', texto: 'Orientación y acompañamiento sindical' },
              { icon: '👥', texto: 'Representación gremial' },
              { icon: '📋', texto: 'Programas de bienestar' },
            ].map(({ icon, texto }) => (
              <li class="flex items-start gap-3 text-sm text-muted">
                <span class="text-base leading-none mt-0.5">{icon}</span>
                {texto}
              </li>
            ))}
          </ul>
        </div>

        <!-- Contacto -->
        <div class="rounded-3xl border border-line bg-white p-6 shadow-sm md:p-8">
          <span class="inline-block rounded-full bg-verde-suave px-3 py-1 text-xs font-extrabold uppercase tracking-widest text-brand-700 mb-4">¿Tienes dudas?</span>
          <h2 class="text-xl font-extrabold text-ink mb-4">Contáctanos</h2>
          <div class="space-y-3">
            <div class="flex items-start gap-3 text-sm text-muted">
              <span class="text-base leading-none mt-0.5">📍</span>
              <span>{datosContacto.sede.direccion}, {datosContacto.sede.ciudad}</span>
            </div>
            <div class="flex items-start gap-3 text-sm text-muted">
              <span class="text-base leading-none mt-0.5">💬</span>
              <a href={datosContacto.canales.whatsapp.url} target="_blank" rel="noopener noreferrer" class="text-brand-700 font-semibold hover:underline">
                WhatsApp oficial SUTENS
              </a>
            </div>
          </div>
          <a
            href={datosContacto.canales.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 btn btn-primary w-full flex items-center justify-center gap-2"
          >
            <Icono name="whatsapp" class="h-4 w-4" />
            Escribir por WhatsApp
          </a>
        </div>

      </div>
    </div>

    <!-- Banner CTA final -->
    <div class="mt-12 rounded-3xl bg-gradient-to-br from-[#0a2715] via-[#103d22] to-[#1b7a3e] p-8 text-white text-center shadow-lg sm:p-12">
      <h2 class="text-3xl font-extrabold mb-4 text-balance">¡Únete a SUTENS hoy!</h2>
      <p class="text-white/80 mb-8 max-w-xl mx-auto text-lg">
        Fortalezcamos la defensa de la educación y los derechos laborales con la participación de más trabajadores.
      </p>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/register.html" class="inline-flex items-center gap-2 rounded-full bg-amber-400 px-7 py-3 font-extrabold text-[#1e293b] shadow-lg transition hover:bg-amber-300 hover:scale-105">
          Afiliarme en línea
        </a>
        <a href="/Formatodeafiliacionsutens.pdf" download class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3 font-extrabold text-white backdrop-blur-sm transition hover:bg-white/20 hover:scale-105">
          <Icono name="download" class="h-4 w-4" />
          Descargar formulario PDF
        </a>
      </div>
    </div>

  </div>
</main>
