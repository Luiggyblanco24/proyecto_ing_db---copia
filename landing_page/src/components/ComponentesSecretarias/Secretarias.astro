<section class="min-h-screen px-4 pb-20 pt-32">
  <div class="mx-auto max-w-6xl">
    <header class="mb-12 text-center">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-[#1b7a38]">Organización territorial</p>
      <h1 class="text-3xl font-bold text-[#1e293b] sm:text-4xl">Directivas de las subdirectivas</h1>
      <p class="mx-auto mt-4 max-w-3xl text-lg text-[#475569]">Presidentes, vicepresidentes y equipos administrativos que representan a los afiliados en cada subdirectiva.</p>
    </header>
    <div id="directivas-subdirectivas" class="space-y-8" aria-live="polite">
      <p class="rounded-xl border border-[#e5e1d6] bg-white p-6 text-center text-[#475569]">Cargando directivas…</p>
    </div>
  </div>
</section>

<script>
  const contenedorDirectivas = document.getElementById('directivas-subdirectivas');

  function crearIntegrante(integrante) {
    const card = document.createElement('article');
    card.className = 'overflow-hidden rounded-xl border border-[#e5e1d6] bg-white shadow-sm';
    const imagen = document.createElement('img');
    imagen.className = 'h-52 w-full bg-[#eaf5ec] object-cover';
    imagen.alt = `Foto de ${integrante.nombre}`;
    if (integrante.foto) imagen.src = integrante.foto;
    else {
      imagen.src = '/brand/sutens-icono.svg';
      imagen.classList.add('object-contain', 'p-8');
    }
    const texto = document.createElement('div');
    texto.className = 'p-4 text-center';
    const cargo = document.createElement('p');
    cargo.className = 'text-sm font-bold uppercase tracking-wide text-[#1b7a38]';
    cargo.textContent = integrante.cargo;
    const nombre = document.createElement('h3');
    nombre.className = 'mt-2 font-bold text-[#1e293b]';
    nombre.textContent = integrante.nombre;
    texto.append(cargo, nombre);
    card.append(imagen, texto);
    return card;
  }

  async function cargarDirectivas() {
    try {
      const response = await fetch('/api/public/directivas/subdirectivas');
      if (!response.ok) throw new Error('No se pudieron cargar las directivas');
      const integrantes = await response.json();
      contenedorDirectivas.replaceChildren();
      const grupos = new Map();
      for (const integrante of integrantes) {
        if (!grupos.has(integrante.id_subdirectiva)) grupos.set(integrante.id_subdirectiva, {
          nombre: integrante.subdirectiva,
          integrantes: [],
        });
        grupos.get(integrante.id_subdirectiva).integrantes.push(integrante);
      }
      if (grupos.size === 0) {
        const vacio = document.createElement('p');
        vacio.className = 'rounded-xl border border-[#e5e1d6] bg-white p-6 text-center text-[#475569]';
        vacio.textContent = 'Las directivas de las subdirectivas aún no están publicadas.';
        contenedorDirectivas.append(vacio);
        return;
      }
      for (const grupo of grupos.values()) {
        const seccion = document.createElement('section');
        seccion.className = 'rounded-2xl border border-[#e5e1d6] bg-white p-6 shadow-sm sm:p-8';
        const titulo = document.createElement('h2');
        titulo.className = 'mb-6 border-b border-[#e5e1d6] pb-4 text-2xl font-bold text-[#1b7a38]';
        titulo.textContent = grupo.nombre;
        const equipo = document.createElement('div');
        equipo.className = 'grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4';
        grupo.integrantes.forEach((integrante) => equipo.append(crearIntegrante(integrante)));
        seccion.append(titulo, equipo);
        contenedorDirectivas.append(seccion);
      }
    } catch {
      contenedorDirectivas.textContent = 'No fue posible cargar las directivas. Intenta actualizar la página.';
    }
  }

  cargarDirectivas();
</script>
