---
import Icono from '../ComponentesIndex/Icono.astro';
import { datosContacto } from '../../data/contacto.js';
---

<!-- Hero llamativo de Subdirectivas -->
<header class="relative isolate overflow-hidden bg-gradient-to-b from-[#0a2715] via-[#103d22] to-[#15803d] pb-16 pt-32 text-white sm:pb-20 sm:pt-40">
  <!-- Efectos de iluminación sutiles -->
  <div class="hero-pattern absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-amber-400/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-20 bottom-0 h-80 w-80 rounded-full bg-emerald-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 text-center sm:px-6">
    <span class="inline-flex items-center gap-2 rounded-full border border-amber-300/30 bg-amber-400/10 px-4 py-1.5 text-xs font-extrabold uppercase tracking-widest text-amber-300 mb-4 shadow-sm">
      <span class="h-2 w-2 rounded-full bg-amber-400" aria-hidden="true"></span>
      Presencia Territorial · Norte de Santander
    </span>

    <h1 class="display text-3xl font-extrabold sm:text-4xl md:text-5xl lg:text-6xl text-balance">
      Directivas de las Subdirectivas
    </h1>

    <p class="mx-auto mt-4 max-w-2xl text-base text-white/85 sm:text-lg text-balance">
      Líderes sindicales y equipos directivos que representan, orientan y defienden los derechos de los afiliados en cada municipio del departamento.
    </p>

    <!-- Barra de filtros rápidos interactivos -->
    <div id="filtros-municipios" class="mt-8 flex flex-wrap items-center justify-center gap-2">
      <button
        type="button"
        class="filtro-btn activo rounded-full border border-white/30 bg-white px-4 py-1.5 text-xs font-extrabold text-brand-900 shadow-sm transition hover:scale-105"
        data-filtro="todos"
      >
        Todas las subdirectivas
      </button>
      <button
        type="button"
        class="filtro-btn rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-extrabold text-white backdrop-blur-sm transition hover:bg-white/20 hover:scale-105"
        data-filtro="abrego"
      >
        Ábrego
      </button>
      <button
        type="button"
        class="filtro-btn rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-extrabold text-white backdrop-blur-sm transition hover:bg-white/20 hover:scale-105"
        data-filtro="el-tarra"
      >
        El Tarra
      </button>
      <button
        type="button"
        class="filtro-btn rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-extrabold text-white backdrop-blur-sm transition hover:bg-white/20 hover:scale-105"
        data-filtro="ocana"
      >
        Ocaña
      </button>
      <button
        type="button"
        class="filtro-btn rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-extrabold text-white backdrop-blur-sm transition hover:bg-white/20 hover:scale-105"
        data-filtro="san-calixto"
      >
        San Calixto
      </button>
    </div>
  </div>
</header>

<!-- Contenido principal de subdirectivas -->
<main class="min-h-screen bg-cream px-4 py-14 sm:px-6 sm:py-20">
  <div class="mx-auto max-w-6xl">
    
    <!-- Contenedor dinámico de equipos -->
    <div id="directivas-subdirectivas" class="space-y-12" aria-live="polite">
      
      <!-- Skeletons modernos mientras cargan los datos de la API -->
      <div class="skeleton-seccion rounded-3xl border border-line bg-white p-6 sm:p-8">
        <div class="h-8 w-1/3 animate-pulse rounded-lg bg-verde-suave mb-6"></div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {Array.from({ length: 4 }).map(() => (
            <div class="flex flex-col items-center rounded-2xl border border-line bg-cream/60 p-6 animate-pulse">
              <div class="h-24 w-24 rounded-2xl bg-verde-suave mb-4"></div>
              <div class="h-4 w-24 rounded bg-line mb-3"></div>
              <div class="h-5 w-36 rounded bg-line mb-2"></div>
              <div class="h-3 w-20 rounded bg-line"></div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Banner complementario de orientación con subdirectivas -->
    <div class="mt-16 rounded-3xl border border-line bg-white p-6 sm:p-10 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-xl text-center md:text-left">
        <span class="rounded-full bg-verde-suave px-3 py-1 text-xs font-extrabold text-brand-700">Atención personalizada</span>
        <h3 class="mt-2 text-xl font-extrabold text-ink sm:text-2xl">¿Perteneces a otro municipio o requieres asesoría?</h3>
        <p class="mt-2 text-sm text-muted">
          Comunícate con la línea oficial de SUTENS o solicita orientación directa para canalizar tu solicitud con el delegado municipal correspondiente.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href={datosContacto.canales.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary flex items-center gap-2"
        >
          <Icono name="whatsapp" class="h-4 w-4" />
          Contactar por WhatsApp
        </a>
        <a href="/Afiliate/" class="btn btn-outline flex items-center gap-2">
          Afíliate a SUTENS
          <Icono name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>

  </div>
</main>

<script>
  import { getDirectivasSubdirectivas } from '../../lib/public-api.js';

  const contenedorDirectivas = document.getElementById('directivas-subdirectivas');
  const botonesFiltro = document.querySelectorAll('.filtro-btn');

  function normalizar(texto: string) {
    return String(texto || '')
      .trim()
      .replace(/\bel tarra\b/gi, 'El Tarra');
  }

  function iniciales(nombre: string) {
    return String(nombre || '')
      .trim()
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((p) => p[0])
      .join('')
      .toUpperCase();
  }

  function crearIntegrante(integrante: any, nombreSubdirectiva: string) {
    const card = document.createElement('article');
    card.className = 'group flex flex-col items-center text-center rounded-2xl border border-line bg-cream/40 p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand-600/40 hover:bg-white hover:shadow-lg';

    // Avatar contenedor elegante (con foto o degradado verde institucional con iniciales)
    const avatarWrapper = document.createElement('div');
    avatarWrapper.className = 'relative mb-4 grid h-24 w-24 shrink-0 place-items-center overflow-hidden rounded-2xl bg-gradient-to-br from-[#1b7a3e] via-[#14532d] to-[#0b2e19] text-white shadow-md ring-4 ring-emerald-500/20';

    const textoIniciales = document.createElement('span');
    textoIniciales.className = 'text-xl font-extrabold tracking-wider';
    textoIniciales.textContent = iniciales(integrante.nombre);
    avatarWrapper.append(textoIniciales);

    if (integrante.foto) {
      const img = document.createElement('img');
      img.src = integrante.foto;
      img.alt = `Foto de ${integrante.nombre}`;
      img.className = 'absolute inset-0 h-full w-full object-cover';
      img.loading = 'lazy';
      img.addEventListener('error', () => img.remove());
      avatarWrapper.append(img);
    }

    // Badge de cargo sindical
    const cargo = document.createElement('span');
    cargo.className = 'rounded-full bg-verde-suave px-3.5 py-1 text-[0.7rem] font-extrabold uppercase tracking-wider text-brand-900 border border-emerald-600/20';
    cargo.textContent = integrante.cargo || 'Directivo';

    // Nombre completo fluido (hasta 2 líneas, sin puntos suspensivos prematuros)
    const nombre = document.createElement('h3');
    nombre.className = 'mt-3 text-base font-extrabold leading-snug text-ink line-clamp-2 break-words';
    nombre.textContent = integrante.nombre || 'Sin nombre asignado';

    // Subdirectiva
    const sub = document.createElement('p');
    sub.className = 'mt-1 text-xs font-semibold text-muted';
    sub.textContent = `Subdirectiva ${nombreSubdirectiva}`;

    card.append(avatarWrapper, cargo, nombre, sub);
    return card;
  }

  async function cargarDirectivas() {
    if (!contenedorDirectivas) return;

    try {
      const integrantes = await getDirectivasSubdirectivas();
      contenedorDirectivas.replaceChildren();

      if (!Array.isArray(integrantes) || integrantes.length === 0) {
        const vacio = document.createElement('div');
        vacio.className = 'rounded-3xl border border-line bg-white p-8 text-center text-muted shadow-sm';
        vacio.innerHTML = `
          <p class="text-lg font-bold text-ink">Las directivas de las subdirectivas aún no están publicadas.</p>
          <p class="mt-2 text-sm">Próximamente se actualizará la nómina de directivos locales.</p>
        `;
        contenedorDirectivas.append(vacio);
        return;
      }

      // Agrupar integrantes por subdirectiva
      const grupos = new Map<number, { id: number; nombre: string; integrantes: any[] }>();
      for (const integrante of integrantes) {
        const id = integrante.id_subdirectiva;
        if (id === undefined || id === null) continue;
        if (!grupos.has(id)) {
          grupos.set(id, {
            id,
            nombre: normalizar(integrante.subdirectiva),
            integrantes: [],
          });
        }
        grupos.get(id)!.integrantes.push(integrante);
      }

      const listaGrupos = [...grupos.values()].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

      // Renderizar cada bloque de subdirectiva
      listaGrupos.forEach((grupo) => {
        const slug = grupo.nombre.toLowerCase().replace(/á/g, 'a').replace(/ñ/g, 'n').replace(/\s+/g, '-');

        const seccion = document.createElement('section');
        seccion.className = 'subdirectiva-bloque rounded-3xl border border-line bg-white p-6 shadow-sm transition-all duration-300 sm:p-8';
        seccion.id = `subdirectiva-${slug}`;
        seccion.setAttribute('data-subdirectiva-slug', slug);

        // Cabecera estilizada de la subdirectiva
        const header = document.createElement('div');
        header.className = 'flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-line pb-5 mb-8';
        header.innerHTML = `
          <div class="flex items-center gap-3.5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-900 text-white shadow-sm">
              <svg class="h-6 w-6 text-[#fbbf24]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 0 1 16 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <div>
              <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">Subdirectiva ${grupo.nombre}</h2>
              <p class="text-xs font-semibold text-muted">Norte de Santander, Colombia</p>
            </div>
          </div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-verde-suave px-3.5 py-1 text-xs font-extrabold text-brand-700 w-fit">
            ${grupo.integrantes.length} ${grupo.integrantes.length === 1 ? 'cargo directivo' : 'cargos directivos'}
          </span>
        `;

        // Grid de directivos
        const equipo = document.createElement('div');
        equipo.className = 'grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4';
        grupo.integrantes.forEach((integrante) => {
          equipo.append(crearIntegrante(integrante, grupo.nombre));
        });

        seccion.append(header, equipo);
        contenedorDirectivas.append(seccion);
      });

    } catch {
      if (contenedorDirectivas) {
        contenedorDirectivas.innerHTML = `
          <div class="rounded-3xl border border-line bg-white p-8 text-center text-muted shadow-sm">
            <p class="text-base font-bold text-ink">No fue posible cargar las directivas en este momento.</p>
            <p class="mt-2 text-sm">Por favor recarga la página o consulta más tarde.</p>
          </div>
        `;
      }
    }
  }

  // Lógica de filtrado interactivo por municipio
  botonesFiltro.forEach((boton) => {
    boton.addEventListener('click', () => {
      const filtro = boton.getAttribute('data-filtro');

      // Actualizar estilo visual activo
      botonesFiltro.forEach((b) => {
        b.classList.remove('bg-white', 'text-brand-900', 'activo');
        b.classList.add('bg-white/10', 'text-white');
      });
      boton.classList.remove('bg-white/10', 'text-white');
      boton.classList.add('bg-white', 'text-brand-900', 'activo');

      const bloques = document.querySelectorAll<HTMLElement>('.subdirectiva-bloque');
      bloques.forEach((bloque) => {
        const slug = bloque.getAttribute('data-subdirectiva-slug') || '';
        if (filtro === 'todos') {
          bloque.style.display = '';
        } else if (slug.includes(filtro || '')) {
          bloque.style.display = '';
          bloque.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          bloque.style.display = 'none';
        }
      });
    });
  });

  cargarDirectivas();
</script>
