---
import Icono from './ComponentesIndex/Icono.astro';
import { datosContacto } from '../data/contacto.js';

const anio = new Date().getFullYear();

const grupos = [
  {
    titulo: 'Organización',
    enlaces: [
      { href: '/Nosotros/', label: 'Nosotros' },
      { href: '/Secretarias/', label: 'Subdirectivas' },
      { href: '/#actividades', label: 'Actividades' },
      { href: '/Comunicaciones/', label: 'Comunicaciones' },
    ],
  },
  {
    titulo: 'Participa',
    enlaces: [
      { href: '/Afiliate/', label: 'Afíliate' },
      { href: '/register.html', label: 'Registro en línea' },
      { href: '/login.html', label: 'Iniciar sesión' },
    ],
  },
];
---

<footer class="relative overflow-hidden bg-[#0b1f15] px-4 pb-8 pt-14 text-white sm:px-6">
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-700 via-brand-600 to-accent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full border border-white/[0.06]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.6fr_0.6fr_0.9fr]">
      <!-- Columna 1: Logo, lema y WhatsApp -->
      <div>
        <a href="/" class="inline-flex rounded-2xl bg-white p-3" aria-label="SUTENS, inicio">
          <img
            src="/brand/sutens-logo-horizontal.svg"
            alt="SUTENS, Defensa de la Educación, Unidad de los Trabajadores"
            width="329"
            height="72"
            class="h-9 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/70">
          {datosContacto.sindicato}. {datosContacto.lema}.
        </p>
        <a
          href={datosContacto.canales.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-white/90 transition hover:text-amber-300"
        >
          <Icono name="whatsapp" class="h-4 w-4 text-emerald-400" />
          WhatsApp: {datosContacto.canales.whatsapp.numero}
        </a>
      </div>

      <!-- Columnas 2 y 3: Enlaces rápidos -->
      {grupos.map((grupo) => (
        <div>
          <h2 class="text-xs font-extrabold uppercase tracking-[0.16em] text-amber-300">{grupo.titulo}</h2>
          <ul class="mt-4 grid gap-2.5">
            {grupo.enlaces.map((enlace) => (
              <li>
                <a href={enlace.href} class="text-sm font-semibold text-white/65 transition hover:text-white">{enlace.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Columna 4: Sede física, Google Maps y Redes oficiales -->
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[0.16em] text-amber-300">Sede principal</h2>
        <p class="mt-4 text-xs leading-relaxed text-white/75">
          {datosContacto.sede.direccionCompleta}
        </p>
        <a
          href={datosContacto.sede.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-bold text-amber-300 hover:underline"
        >
          <Icono name="map-pin" class="h-3.5 w-3.5" />
          Ver ubicación en Google Maps
        </a>

        <div class="mt-6">
          <h3 class="text-xs font-extrabold uppercase tracking-[0.16em] text-amber-300">Canales oficiales</h3>
          <div class="mt-3 flex items-center gap-3">
            <a
              href={datosContacto.canales.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-white/10 text-white transition hover:border-amber-300 hover:bg-white/20 hover:text-amber-300"
              aria-label="Contactar a SUTENS por WhatsApp"
            >
              <Icono name="whatsapp" class="h-4 w-4" />
            </a>
            <a
              href={datosContacto.canales.facebook.url}
              target="_blank"
              rel="noopener noreferrer"
              class="grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-white/10 text-white transition hover:border-amber-300 hover:bg-white/20 hover:text-amber-300"
              aria-label="Página de Facebook oficial de SUTENS"
            >
              <Icono name="facebook" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Barra inferior legal -->
    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p>© {anio} {datosContacto.sindicato} ({datosContacto.sigla})</p>
        <p class="mt-1 text-white/50">NIT: {datosContacto.legal.nit} · Registro MinTrabajo {datosContacto.legal.registroMinTrabajo}</p>
      </div>
      <p class="text-amber-300/80 font-medium">{datosContacto.lema}</p>
    </div>
  </div>
</footer>
