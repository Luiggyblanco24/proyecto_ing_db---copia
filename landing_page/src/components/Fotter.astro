---
import Icono from './ComponentesIndex/Icono.astro';

const anio = new Date().getFullYear();

const grupos = [
  {
    titulo: 'Organización',
    enlaces: [
      { href: '/Nosotros/', label: 'Nosotros' },
      { href: '/Secretarias/', label: 'Subdirectivas' },
      { href: '/#actividades', label: 'Actividades' },
      { href: '/Comunicaciones/', label: 'Comunicaciones' },
    ],
  },
  {
    titulo: 'Participa',
    enlaces: [
      { href: '/Afiliate/', label: 'Afíliate' },
      { href: '/register.html', label: 'Registro en línea' },
      { href: '/login.html', label: 'Iniciar sesión' },
    ],
  },
];

const redes = [
  { nombre: 'Instagram', icono: 'instagram' },
  { nombre: 'Facebook', icono: 'facebook' },
  { nombre: 'X', icono: 'x' },
  { nombre: 'WhatsApp', icono: 'whatsapp' },
];
---

<footer class="relative overflow-hidden bg-[#0b1f15] px-4 pb-8 pt-14 text-white sm:px-6">
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-brand-700 via-brand-600 to-accent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full border border-white/[0.06]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.6fr_0.6fr_0.8fr]">
      <div>
        <a href="/" class="inline-flex rounded-2xl bg-white p-3" aria-label="SUTENS, inicio">
          <img
            src="/brand/sutens-logo-horizontal.svg"
            alt="SUTENS, Defensa de la Educación, Unidad de los Trabajadores"
            width="329"
            height="72"
            class="h-9 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/65">
          Sindicato Unitario de Trabajadores de la Educación de Norte de Santander. Defensa de la Educación, Unidad de los Trabajadores.
        </p>
        <a href="mailto:afiliaciones@sutens.org" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-white/80 transition hover:text-amber-300">
          <Icono name="mail" class="h-4 w-4" />
          afiliaciones@sutens.org
        </a>
      </div>

      {grupos.map((grupo) => (
        <div>
          <h2 class="text-xs font-extrabold uppercase tracking-[0.16em] text-amber-300">{grupo.titulo}</h2>
          <ul class="mt-4 grid gap-2.5">
            {grupo.enlaces.map((enlace) => (
              <li>
                <a href={enlace.href} class="text-sm font-semibold text-white/65 transition hover:text-white">{enlace.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[0.16em] text-amber-300">Redes</h2>
        <p class="mt-4 text-xs font-semibold text-white/60">Enlaces oficiales por confirmar.</p>
        <div class="mt-4 flex flex-wrap gap-2" aria-hidden="true">
          {redes.map((red) => (
            <span
              class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-white/5 text-white/40"
              title={`${red.nombre} (enlace pendiente)`}
            >
              <Icono name={red.icono} class="h-4 w-4" />
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} SUTENS · Norte de Santander</p>
      <p>Defensa de la Educación, Unidad de los Trabajadores.</p>
    </div>
  </div>
</footer>
