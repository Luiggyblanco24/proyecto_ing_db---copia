# Copia este archivo a .env y ajusta los valores
PORT=3000
CORS_ORIGINS=http://localhost:3000

# Supabase Storage: claves de servidor, nunca exponer la service role key al navegador
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=reemplazar_por_la_clave_service_role

# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sutens

# Secreto para firmar los JWT (cámbialo en producción)
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=7d

# Asistente apagado por defecto; requiere habilitación explícita
CHATBOT_ENABLED=false
# Cloudflare Workers AI: mantener ambos valores solo en el entorno del servidor
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CHATBOT_CONVERSATION_RATE_LIMIT=20
CHATBOT_CONVERSATION_RATE_WINDOW_MS=60000
# Informes agregados del asistente (Administrador SUTENS)
CHATBOT_REPORT_RATE_LIMIT=30
CHATBOT_REPORT_RATE_WINDOW_MS=60000
CHATBOT_REPORT_TIMEOUT_MS=5000
CHATBOT_REPORT_MAX_ROWS=200
CHATBOT_REPORT_MIN_GROUP_SIZE=5
# Descargas de datos personales: desactivadas salvo habilitación explícita
CHATBOT_DOWNLOADS_ENABLED=false
CHATBOT_DOWNLOAD_MAX_RECORDS=1000
CHATBOT_DOWNLOAD_RATE_LIMIT=5
CHATBOT_DOWNLOAD_RATE_WINDOW_MS=600000
CHATBOT_DOWNLOAD_ALERT_RECORDS=2000
